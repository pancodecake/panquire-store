<div class="pq pq-purchase-accordion" {{ block.shopify_attributes }}>
  <details class="pq-purchase-accordion__details"{% if block.settings.open %} open{% endif %}>
    <summary>
      <span class="pq-purchase-accordion__heading">
        <span class="pq-purchase-accordion__icon-slot" aria-hidden="true">
          {% case block.settings.icon %}
            {% when 'shipping' %}{{ 'pq-trust-shipping.svg' | inline_asset_content }}
            {% when 'price' %}{{ 'pq-trust-price.svg' | inline_asset_content }}
            {% when 'warranty' %}{{ 'pq-trust-warranty.svg' | inline_asset_content }}
            {% when 'legal' %}{{ 'pq-trust-legal.svg' | inline_asset_content }}
            {% when 'included' %}{{ 'icon-checkmark.svg' | inline_asset_content }}
          {% endcase %}
        </span>
        <span>{{ block.settings.heading | escape }}</span>
      </span>
      <span class="pq-purchase-accordion__indicator" aria-hidden="true"></span>
    </summary>
    {% if block.settings.show_included_accessories %}
      {% render 'pq-included-accessories', product: product %}
    {% else %}
      <div class="rte">{% if block.settings.use_product_description %}{{ product.description }}{% else %}{{ block.settings.text }}{% endif %}</div>
    {% endif %}
  </details>
</div>
{% schema %}
{
  "name":"Panquire product details","tag":null,
  "settings":[
    {"type":"checkbox","id":"use_product_description","label":"Use product description","default":false},
    {"type":"checkbox","id":"show_included_accessories","label":"Show included accessories","default":false},
    {"type":"select","id":"icon","label":"Icon","options":[
      {"value":"none","label":"None"},
      {"value":"shipping","label":"Shipping"},
      {"value":"price","label":"Price protection"},
      {"value":"warranty","label":"Warranty"},
      {"value":"legal","label":"Legal information"},
      {"value":"included","label":"Included accessories"}
    ],"default":"none"},
    {"type":"text","id":"heading","label":"Heading","default":"Shipping & returns"},
    {"type":"richtext","id":"text","label":"Content","default":"<p>Details coming soon.</p>"},
    {"type":"checkbox","id":"open","label":"Open initially","default":false}
  ],
  "presets":[{"name":"Panquire product details"}]
}
{% endschema %}
