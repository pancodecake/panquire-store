{% liquid
  assign accessory_products = block.settings.products
  assign product_count = accessory_products.count
%}

{% if product_count > 0 or request.design_mode %}
  <script src="{{ 'pq-complete-ride.js' | asset_url }}" type="module" fetchpriority="low"></script>
  <pq-complete-ride class="pq pq-complete-ride" {{ block.shopify_attributes }}>
    {% if product_count > 0 %}
      <details{% if block.settings.open %} open{% endif %}>
        <summary>
          <span>{{ block.settings.heading | escape }}</span>
          <span class="pq-complete-ride__indicator" aria-hidden="true"></span>
        </summary>

        <div class="pq-complete-ride__panel">
          <div class="pq-complete-ride__list" role="list">
            {% for accessory_product in accessory_products %}
              {% assign accessory_variant = accessory_product.selected_or_first_available_variant %}
              {% assign row_index = forloop.index %}
              <article
                class="pq-complete-ride__row"
                role="listitem"
                data-accessory-row
                {% if row_index > block.settings.visible_rows %}hidden{% endif %}
              >
                <input
                  id="Accessory-{{ block.id }}-{{ accessory_product.id }}"
                  class="pq-complete-ride__checkbox"
                  type="checkbox"
                  data-accessory-toggle
                  data-variant-id="{{ accessory_variant.id }}"
                  {% unless accessory_variant.available %}disabled{% endunless %}
                >

                <label class="pq-complete-ride__media" for="Accessory-{{ block.id }}-{{ accessory_product.id }}">
                  {% if accessory_product.featured_image != blank %}
                    {{ accessory_product.featured_image | image_url: width: 180 | image_tag: widths: '90, 120, 180', sizes: '72px', loading: 'lazy', alt: accessory_product.featured_image.alt | default: accessory_product.title }}
                  {% endif %}
                </label>

                <div class="pq-complete-ride__copy">
                  <label class="pq-complete-ride__title" for="Accessory-{{ block.id }}-{{ accessory_product.id }}">
                    {{ accessory_product.title | escape }}
                  </label>
                  {% unless accessory_product.has_only_default_variant %}
                    <label class="visually-hidden" for="AccessoryVariant-{{ block.id }}-{{ accessory_product.id }}">
                      {{ accessory_product.title | escape }} options
                    </label>
                    <select
                      id="AccessoryVariant-{{ block.id }}-{{ accessory_product.id }}"
                      class="pq-complete-ride__variant"
                      data-accessory-variant
                    >
                      {% for variant in accessory_product.variants %}
                        {% if settings.currency_code_enabled_product_pages %}
                          {% assign formatted_price = variant.price | money_with_currency %}
                        {% else %}
                          {% assign formatted_price = variant.price | money %}
                        {% endif %}
                        <option
                          value="{{ variant.id }}"
                          data-price="{{ formatted_price | escape }}"
                          {% unless variant.available %}disabled{% endunless %}
                          {% if variant.id == accessory_variant.id %}selected{% endif %}
                        >
                          {{ variant.title | escape }}{% unless variant.available %} — {{ 'products.product.sold_out' | t }}{% endunless %}
                        </option>
                      {% endfor %}
                    </select>
                  {% endunless %}
                </div>

                <span class="pq-complete-ride__price" data-accessory-price aria-live="polite">
                  {% if settings.currency_code_enabled_product_pages %}
                    {{ accessory_variant.price | money_with_currency }}
                  {% else %}
                    {{ accessory_variant.price | money }}
                  {% endif %}
                </span>
              </article>
            {% endfor %}
          </div>

          {% if product_count > block.settings.visible_rows %}
            <button
              class="pq-complete-ride__more button-unstyled"
              type="button"
              data-accessory-show-more
              data-show-more="{{ 'actions.show_more' | t | escape }}"
              data-show-less="{{ 'actions.show_less' | t | escape }}"
              aria-expanded="false"
            >
              {{ 'actions.show_more' | t }} ({{ product_count | minus: block.settings.visible_rows }})
            </button>
          {% endif %}
          <p class="pq-complete-ride__cart-note" data-accessory-cart-note hidden>
            {{ block.settings.selected_note | escape }}
          </p>
        </div>
      </details>
    {% else %}
      <div class="pq-complete-ride__editor-empty">
        Select optional accessory products to show “{{ block.settings.heading | escape }}”.
      </div>
    {% endif %}
  </pq-complete-ride>
{% endif %}

{% stylesheet %}
  .pq-complete-ride {
    display: block;
    width: 100%;
  }

  .pq-complete-ride details {
    border-block: 1px solid var(--pq-line);
  }

  .pq-complete-ride summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 17px 0;
    color: var(--color-heading-accent);
    cursor: pointer;
    font-weight: 700;
    list-style: none;
  }

  .pq-complete-ride summary::-webkit-details-marker {
    display: none;
  }

  .pq-complete-ride__indicator {
    width: 9px;
    height: 9px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg) translate(-2px, 2px);
    transition: transform 180ms ease;
  }

  .pq-complete-ride details[open] .pq-complete-ride__indicator {
    transform: rotate(225deg) translate(-2px, 2px);
  }

  .pq-complete-ride__panel {
    padding-bottom: 18px;
  }

  .pq-complete-ride__list {
    overflow: hidden;
    border: 1px solid var(--pq-line);
    border-radius: 3px;
  }

  .pq-complete-ride__row {
    display: grid;
    grid-template-columns: 20px 68px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    min-height: 92px;
    padding: 10px 14px;
    background: #fff;
  }

  .pq-complete-ride__row + .pq-complete-ride__row {
    border-top: 1px dotted var(--pq-line);
  }

  .pq-complete-ride__row[data-selected='true'] {
    background: color-mix(in srgb, var(--color-action-solid) 7%, #fff);
  }

  .pq-complete-ride__checkbox {
    width: 18px;
    height: 18px;
    margin: 0;
    accent-color: var(--color-action-solid);
  }

  .pq-complete-ride__media {
    display: grid;
    width: 68px;
    height: 68px;
    place-items: center;
    cursor: pointer;
  }

  .pq-complete-ride__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .pq-complete-ride__copy {
    min-width: 0;
  }

  .pq-complete-ride__title {
    display: block;
    color: var(--color-heading-accent);
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.35;
  }

  .pq-complete-ride__variant {
    max-width: 100%;
    min-height: 30px;
    margin-top: 7px;
    padding: 3px 26px 3px 7px;
    border: 1px solid var(--pq-line);
    border-radius: 2px;
    background: #fff;
    color: var(--text);
    font: inherit;
    font-size: 11px;
  }

  .pq-complete-ride__price {
    color: var(--color-heading-accent);
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
  }

  .pq-complete-ride__more {
    display: block;
    margin: 12px 0 0 auto;
    color: var(--color-heading-accent);
    font-size: 12px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pq-complete-ride__cart-note {
    margin: 12px 0 0;
    color: var(--text-muted);
    font-size: 12px;
    line-height: 1.5;
  }

  .product-details[data-accessories-selected='true'] .accelerated-checkout-block {
    display: none;
  }

  .pq-complete-ride__editor-empty {
    padding: 16px;
    border: 1px dashed var(--pq-line);
    color: var(--text-muted);
    font-size: 13px;
  }

  @media (max-width: 420px) {
    .pq-complete-ride__row {
      grid-template-columns: 18px 56px minmax(0, 1fr);
      gap: 9px;
      padding: 10px;
    }

    .pq-complete-ride__media {
      width: 56px;
      height: 56px;
    }

    .pq-complete-ride__price {
      grid-column: 3;
      justify-self: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pq-complete-ride__indicator {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Complete Your Ride",
  "tag": null,
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Complete Your Ride"},
    {"type":"product_list","id":"products","label":"Optional accessory products","limit":10},
    {"type":"range","id":"visible_rows","label":"Rows before Show more","min":2,"max":6,"step":1,"default":4},
    {"type":"checkbox","id":"open","label":"Open initially","default":true},
    {"type":"text","id":"selected_note","label":"Selected-accessory message","default":"Use Add to Cart to include selected accessories with your bike."}
  ],
  "presets": [{"name":"Complete Your Ride"}]
}
{% endschema %}
