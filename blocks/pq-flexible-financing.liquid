{% doc %}
  Renders the product-page financing reassurance and the store's enabled payment methods.
{% enddoc %}

<aside class="pq pq-flexible-financing" aria-labelledby="FinancingTitle-{{ block.id }}" {{ block.shopify_attributes }}>
  <span class="pq-flexible-financing__icon-slot" aria-hidden="true"></span>
  <div class="pq-flexible-financing__copy">
    <h2 id="FinancingTitle-{{ block.id }}">{{ block.settings.heading | escape }}</h2>
    <p>{{ block.settings.text | escape }}</p>
  </div>
  {% if shop.enabled_payment_types != empty %}
    <div class="pq-payment-methods pq-payment-methods--product-finance" aria-label="{{ 'blocks.payment_methods' | t | escape }}">
      <span class="pq-payment-methods__label">{{ 'blocks.payment_methods' | t }}</span>
      <ul class="pq-payment-methods__list" role="list">
        {% for type in shop.enabled_payment_types %}
          <li>{{ type | payment_type_svg_tag: class: 'pq-payment-methods__icon' }}</li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}
</aside>

{% schema %}
{
  "name": "Flexible financing",
  "tag": null,
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Flexible financing"},
    {"type":"text","id":"text","label":"Supporting text","default":"Secure payment options available at checkout."}
  ],
  "presets":[{"name":"Flexible financing"}]
}
{% endschema %}
