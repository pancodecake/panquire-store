      <path d="M9 10.5h14l2 17H7l2-17Z"/><path d="M12 11V8a4 4 0 0 1 8 0v3m-2.5 5.1c-1.1-.6-3-.8-3 .6 0 2.1 5.2 1.4 4.8 5-.4 3.4-5.2 3.4-7.5 1.8"/>
  {% endcase %}
</svg>
