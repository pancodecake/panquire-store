{% doc %}
  Renders an icon used by the footer trust indicators.
  @param {string} name - guarantee, lock, or shield.
{% enddoc %}
<svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  {% case name %}
    {% when 'guarantee' %}
      <circle cx="16" cy="16" r="13"/><path d="m9.5 16.2 4.2 4.1 8.8-9"/>
    {% when 'lock' %}
      <rect x="7" y="13" width="18" height="14" rx="2"/><path d="M11 13V9a5 5 0 0 1 10 0v4m-5 5v4"/>
    {% when 'shield' %}
      <path d="M16 3 27 7v8c0 7.1-4.5 11.6-11 14C9.5 26.6 5 22.1 5 15V7l11-4Z"/><path d="m10.5 16 3.6 3.5 7.4-7.5"/>
  {% endcase %}
</svg>
