{% doc %}
  Default footer destinations; a merchant-selected column menu can replace these.
  @param {object} block - Footer column and product selections.
  @param {object} footer_settings - Footer destination settings.
{% enddoc %}
{% assign partner_url = settings.pq_partners_url | default: '/pages/partners' %}
{% assign terms_url = pages.tos.url | default: '/pages/tos' %}
<nav aria-label="{{ block.settings.heading | escape }}">
  {% case block.settings.built_in %}
    {% when 'shop' %}
      <a href="{{ pages.compare.url | default: '/pages/compare' }}">{{ 'panquire.storefront.panquire_vs_competitors' | t | replace: '&amp;', '&' | escape }}</a>
      <a href="{% render 'pq-local-path', url: '/products/t-01' %}">T-01</a>
      <a href="{% render 'pq-local-path', url: '/products/t-02' %}">T-02</a>
      <a href="{% render 'pq-local-path', url: '/products/t-03' %}">T-03</a>
    {% when 'company' %}
      <a href="{{ settings.pq_about_url | default: '/pages/about' }}">{{ 'panquire.storefront.about_us' | t | replace: '&amp;', '&' | escape }} <span class="pq-footer-link-detail">{{ 'panquire.storefront.our_story_team_mission' | t | replace: '&amp;', '&' | escape }}</span></a>
      <a href="{% render 'pq-local-path', url: partner_url %}#partners">{{ 'panquire.storefront.strategic_partnerships' | t | replace: '&amp;', '&' | escape }}</a>
    {% when 'business' %}
      <a href="{% render 'pq-local-path', url: partner_url %}#corporate-purchase">{{ 'panquire.storefront.corporate_bulk_purchase' | t | replace: '&amp;', '&' | escape }} <span class="pq-footer-link-detail">{{ 'panquire.storefront.dealers_fleet' | t | replace: '&amp;', '&' | escape }}</span></a>
      <a href="{% render 'pq-local-path', url: partner_url %}#affiliate-program">{{ 'panquire.storefront.affiliate_program' | t | replace: '&amp;', '&' | escape }}</a>
      <a href="{% render 'pq-local-path', url: partner_url %}#affiliate-terms">{{ 'panquire.storefront.affiliate_terms' | t | replace: '&amp;', '&' | escape }}</a>
    {% when 'care' %}
      <a href="{{ footer_settings.contact_url | default: '/pages/contact' }}">{{ 'panquire.storefront.contact_us' | t | replace: '&amp;', '&' | escape }}</a>
      <a href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}">{{ 'panquire.storefront.shipping_policy' | t | replace: '&amp;', '&' | escape }}</a>
      <a href="{% render 'pq-local-path', url: terms_url %}#payment">{{ 'panquire.storefront.payment_methods' | t | replace: '&amp;', '&' | escape }}</a>
      <a href="{% render 'pq-local-path', url: terms_url %}#warranty">{{ 'panquire.storefront.warranty_policy' | t | replace: '&amp;', '&' | escape }}</a>
      <a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">{{ 'panquire.storefront.returns_refunds' | t | replace: '&amp;', '&' | escape }}</a>
  {% endcase %}
</nav>

