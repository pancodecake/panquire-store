{% doc %}
  T-02 product showcase using the shared Panquire buying-guide layout.
  @param {product} product - Current T-02 product.
{% enddoc %}
{% liquid
  assign guide_image = images['panquire-t02-garage.jpg'] | default: product.featured_image
  assign variant = product.selected_or_first_available_variant
%}
{{ 'pq-buying-guide.css' | asset_url | stylesheet_tag }}
{% if product.variants.size > 1 %}
  <script type="module" src="{{ 'pq-product-guide-price.js' | asset_url }}"></script>
{% endif %}
<section class="pq-buying-guide pq-buying-guide__product pq-product-guide pq-product-guide--t02">
  {% if guide_image != blank %}
    <div class="pq-product-guide__image">
      {{ guide_image | image_url: width: 2640 | image_tag: widths: '360, 540, 750, 990, 1320, 1800, 2240, 2640', sizes: '(min-width: 1416px) 1320px, (min-width: 990px) calc(100vw - 96px), (min-width: 600px) calc(100vw - 48px), calc(100vw - 40px)', loading: 'lazy', decoding: 'async', alt: 'Black and gold Panquire T-02 72V electric dirt bike in a motorcycle workshop' }}
    </div>
  {% endif %}
  <div class="pq-product-guide__card">
    <div class="pq-product-guide__lead">
      <div>
        <p class="pq-product-guide__eyebrow">{{ 'panquire.storefront.panquire_t_02_price_and_performance' | t | escape_once }}</p>
        <h2>{{ 'panquire.storefront.a_72v_electric_dirt_bike_for_demanding' | t | escape_once }}</h2>
        <p>{{ 'panquire.storefront.the_t_02_pairs_a_13_kw' | t | escape_once }}</p>
      </div>

    </div>
    <dl class="pq-product-guide__specs">
      <div><dt>{{ 'panquire.storefront.13_kw_peak_performance' | t | escape_once }}</dt><dd>{{ 'panquire.storefront.stated_top_speed_of_100_km_h' | t | escape_once }}</dd></div>
      <div><dt>{{ 'panquire.storefront.removable_72v_41ah_battery' | t | escape_once }}</dt><dd>{{ 'panquire.storefront.up_to_90_km_in_eco_mode' | t | escape_once }}</dd></div>
      <div><dt>{{ 'panquire.storefront.off_road_control' | t | escape_once }}</dt><dd>{{ 'panquire.storefront.three_power_levels_dual_piston_hydraulic_disc' | t | escape_once }}</dd></div>
    </dl>
    <div class="pq-buying-guide__links">
      <a href="{{ pages.compare.url | default: '/pages/compare' }}">{{ 'panquire.storefront.compare_electric_dirt_bike_models' | t | escape_once }}</a>
      <a href="{{ pages.contact.url | default: '/pages/contact' }}">{{ 'panquire.storefront.ask_about_rider_fit' | t | escape_once }}</a>
      {% if all_products['t-01'].url != blank %}<a href="{{ all_products['t-01'].url }}">{{ 'panquire.storefront.explore_the_60v_t_01' | t | escape_once }}</a>{% endif %}
    </div>
  </div>
</section>
