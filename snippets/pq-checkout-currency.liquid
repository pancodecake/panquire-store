{% doc %}
  Explains how checkout currency can differ from storefront currency.
{% enddoc %}
{% assign display_currency = cart.currency.iso_code | default: shop.currency %}
{% if display_currency != shop.currency %}
  {% assign currency_notice = 'panquire.checkout_currency' | t: display_currency: display_currency, store_currency: shop.currency %}
  <p class="pq-checkout-currency">
    {{ currency_notice }}
  </p>
{% endif %}

{% stylesheet %}
  .pq-checkout-currency {
    margin-block: 0 8px;
    font-size: var(--font-size--sm);
  }
{% endstylesheet %}
