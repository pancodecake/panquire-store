{% doc %}
  Renders reusable cart drawer markup for both initial page loads and Section Rendering API responses.

  @param {boolean} [render_wrapper] - When true, wraps the drawer in the section wrapper that the Section Rendering API adds automatically.
{% enddoc %}

{%- liquid
  assign render_wrapper = render_wrapper | default: true, allow_false: true
-%}

  {% if render_wrapper %}
    <div
      id="shopify-section-cart-drawer-section"
      class="shopify-section"
    >
  {% endif %}

  <script
    type="module"
    src="{{ 'cart-drawer.js' | asset_url }}"
    fetchpriority="low"
  ></script>

  {% capture empty_cart_drawer_content %}
    <div
      class="cart-drawer__content"
      aria-label="{{ 'accessibility.cart' | t }}"
    >
      <p class="cart-drawer__empty-message">
        {{ 'content.your_cart_is_empty' | t }}
      </p>

      <div class="cart-drawer__items">
        {% render 'cart-products', force_empty: true, context: 'drawer' %}
      </div>
    </div>
  {% endcapture %}

  <theme-drawer
    id="cart-drawer"
    modal
    no-persist
    data-skip-node-update
  >
    <dialog
      ref="panel"
      class="theme-drawer__dialog color-custom-drawer"
      aria-labelledby="cart-drawer-heading"
      cart-summary-sticky="true"
    >
      <cart-drawer-component
        {% if settings.auto_open_cart_drawer %}
          auto-open
        {% endif %}
      >
        <template id="empty-cart-template">
          {{ empty_cart_drawer_content }}
        </template>

        <div
          class="cart-drawer__inner{% if cart.empty? %} cart-drawer--empty{% endif %}"
          data-hydration-key="cart-drawer-inner"
        >
          {% capture cart_badge_html %}
              <span
                class="theme-drawer__badge{% if cart.item_count == 0 %} visually-hidden{% endif %}"
                aria-hidden="true"
                {% if cart.item_count <= 99 %}
                  data-maintain-ratio
                {% endif %}
              >
                {{- cart.item_count -}}
              </span>
              {% if cart.item_count > 0 %}
                <span class="visually-hidden">
                  {{ 'accessibility.cart_count' | t }}: {{ cart.item_count }}
                </span>
              {% endif %}
          {% endcapture %}
          {% assign cart_drawer_title = 'content.cart_title' | t %}
          {% render 'theme-drawer-header',
            title: cart_drawer_title,
            drawer_id: 'cart-drawer',
            heading_id: 'cart-drawer-heading',
            title_append: cart_badge_html
          %}

          {% capture cart_items_children %}
            {%- if cart.empty? -%}
              {{ empty_cart_drawer_content }}
            {%- else -%}
              <scroll-hint
                class="cart-drawer__content"
                aria-label="{{ 'accessibility.cart' | t }}"
              >
                <scroll-hint class="cart-drawer__items">
                  {% render 'cart-products', context: 'drawer' %}
                </scroll-hint>

                <div class="cart-drawer__summary">
                  {% render 'cart-summary', section_id: 'cart-drawer-section' %}
                </div>
              </scroll-hint>
            {%- endif -%}
          {% endcapture %}
          {% render 'cart-items-component',
            children: cart_items_children,
            is_drawer: true,
            section_id: 'cart-drawer-section'
          %}
        </div>
      </cart-drawer-component>
    </dialog>
  </theme-drawer>

  {% if render_wrapper %}
    </div>
  {% endif %}

{% stylesheet %}
  #cart-drawer > dialog {
    --theme-drawer-width: 30rem;
    --theme-drawer-padding: clamp(1rem, 4vw, 1.5rem);
    --cart-panel-motion: 320ms cubic-bezier(0.22, 0.75, 0.2, 1);
    --color-background: var(--pq-bg);
    --color-foreground: var(--pq-text);
    --color-foreground-subdued: var(--pq-muted);

    animation: none;
    background: var(--pq-bg);
    border-left: 1px solid var(--pq-line);
    box-shadow: -12px 0 48px rgb(0 0 0 / 32%);
    margin: 0;
    overscroll-behavior: contain;
    transform: translateX(100%);
    transition: transform var(--cart-panel-motion);
  }

  #cart-drawer[open] > dialog {
    transform: translateX(0);
  }

  #cart-drawer > dialog::backdrop {
    background: rgb(0 0 0 / 60%);
    opacity: 0;
    transition: opacity 160ms ease-out;
  }

  #cart-drawer[open] > dialog::backdrop {
    opacity: 1;
  }

  #cart-drawer .theme-drawer__header {
    background: var(--pq-surface);
    border-bottom: 1px solid var(--pq-line);
    padding-block: 0.75rem;
  }

  #cart-drawer .theme-drawer__title {
    font: 700 1.375rem/1.2 var(--pq-heading-font);
    letter-spacing: -0.025em;
  }

  #cart-drawer .theme-drawer__close-button {
    --private-button-size: 44px;

    color: var(--pq-text);
    background: var(--pq-surface);
    border-color: var(--pq-line);
    box-shadow: none;
  }

  #cart-drawer .theme-drawer__close-button:is(:hover, :active) {
    background: var(--pq-line);
  }

  #cart-drawer .cart-totals__total-value {
    font-size: 1.25rem;
    font-variant-numeric: tabular-nums;
  }

  #cart-drawer :focus-visible {
    outline-color: var(--color-focus-ring);
  }

  @media (prefers-reduced-motion: reduce) {
    #cart-drawer > dialog {
      opacity: 0;
      transform: none;
      transition: opacity 160ms ease-out;
    }

    #cart-drawer[open] > dialog {
      opacity: 1;
      transform: none;
    }
  }

  cart-drawer-component {
    --cart-drawer-padding: var(--theme-drawer-padding);
    --font-paragraph--line-height: 1;
    display: contents;
  }

  .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .cart-drawer__inner > .cart-items-component {
    flex: 1;
    min-height: 0;
    height: auto;
  }

  .cart-drawer__content {
    display: flex;
    flex-direction: column;
    padding: 0;
    background-color: #151619;
    flex-grow: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .cart-drawer__items {
    display: flex;
    flex-direction: column;
    padding-inline: var(--cart-drawer-padding);
    overflow-y: auto;
    padding-block: var(--cart-drawer-padding);
    overscroll-behavior: contain;
  }

  .cart-drawer__items .cart-items__table-row:not(.pq-cart-item-card) {
    padding-bottom: var(--gap-lg);
    border-bottom: 1px solid var(--pq-line);
    margin-bottom: var(--gap-lg);
  }

  .cart-drawer__items .cart-items__table-row:not(.pq-cart-item-card):has(+ .cart-items__nested-line) {
    border-bottom: none;
    margin-bottom: 0;
  }

  .cart-drawer__items .cart-items__table-row:not(.pq-cart-item-card):last-child {
    border-bottom: none;
    padding-block-end: 0;
    margin-block-end: 0;
  }

  .cart-drawer__summary {
    position: sticky;
    bottom: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-md);
    padding: var(--cart-drawer-padding);
    padding-bottom: max(var(--cart-drawer-padding), env(safe-area-inset-bottom));
    background-color: var(--pq-surface);
    border-top: 1px solid var(--pq-line);
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__summary {
    position: static;
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__items {
    overflow: unset;
  }

  .cart-actions summary {
    padding-inline: 0;
    padding-block: var(--padding-sm);
    line-height: 1.2;
    min-height: var(--minimum-touch-target);
  }

  .cart-drawer__summary .cart__summary-totals:not(:has(.cart__subtotal-container:empty)) {
    border-block-start: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block-start: var(--padding-2xl);
  }

  .cart-drawer__summary .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start: var(--margin-3xs);
    }
  }

  .cart-drawer--empty .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
    min-height: auto;
  }

  .cart-drawer--empty .cart-drawer__items {
    padding-inline: 0;
  }

  .cart-drawer__empty-message {
    margin: 0;
    color: var(--pq-muted);
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__items {
    padding-inline: 0;
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    html:active-view-transition-type(empty-cart-drawer) {
      .theme-drawer__close-button {
        view-transition-name: cart-drawer-close-button;
      }
    }
  }

  :active-view-transition {
    .cart-drawer__header,
    .cart-drawer__content {
      background: transparent;
    }
  }
{% endstylesheet %}
