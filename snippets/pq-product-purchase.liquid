{% doc %}
  Renders the Panquire product information purchase panel.
  @param {product} product - Current product.
  @param {section} section - Product information section.
  @param {block} block - Product details block.
{% enddoc %}

{{ 'pq-product-purchase.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pq-purchase-panel.js' | asset_url }}" defer></script>
{% render 'add-to-cart-button-styles' %}
{% render 'fly-to-cart-styles' %}
{% render 'buy-buttons-styles' %}
{% liquid
  assign variant = product.selected_or_first_available_variant
  assign can_purchase = variant.available
  assign minimum = variant.quantity_rule.min | default: 1
  assign maximum = variant.quantity_rule.max
  if variant.inventory_management != blank
    assign maximum = variant.inventory_quantity
    if variant.quantity_rule.max != blank
      assign maximum = maximum | at_most: variant.quantity_rule.max
    endif
  endif
  if variant.inventory_management != blank and variant.inventory_quantity < minimum
    assign can_purchase = false
  endif
  assign form_id = 'PanquirePurchase-' | append: section.id
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  assign rating = product.metafields.reviews.rating.value.rating
  assign rating_width = rating | times: 20 | at_least: 0 | at_most: 100
%}

<pq-purchase-panel class="pq-purchase" {{ block.shopify_attributes }}>
  <p class="pq-purchase__tagline">{% render 'pq-purchase-copy', key: 'tagline' %}</p>
  <h1 class="pq-purchase__title">{% unless product.title contains 'Panquire' or product.title contains 'PANQUIRE' %}Panquire {% endunless %}{{ product.title | escape }}{% if product.title.size < 24 %} {% render 'pq-purchase-copy', key: 'title_suffix' %}{% endif %}</h1>
  {% if rating != blank and rating_count > 0 %}
    <div class="pq-purchase__reviews">
      <span class="pq-purchase__stars" role="img" aria-label="{% render 'pq-purchase-copy', key: 'rating', rating: rating %}" style="--rating-width: {{ rating_width }}%"><span aria-hidden="true">★★★★★</span><span class="pq-purchase__stars-fill" aria-hidden="true">★★★★★</span></span>
      <span class="pq-purchase__review-count">{% render 'pq-purchase-copy', key: 'review_count', count: rating_count %}</span>
    </div>
  {% endif %}
  <div class="pq-purchase__price-row" aria-live="polite">
    <strong>{{ variant.price | money_with_currency }}</strong>
    {% if variant.compare_at_price > variant.price %}
      <s>{{ variant.compare_at_price | money_with_currency }}</s>
      {% assign discount = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round %}
      <span class="pq-purchase__discount">{% render 'pq-purchase-copy', key: 'discount', percent: discount %}</span>
    {% endif %}
  </div>
  <p class="pq-purchase__stock{% unless can_purchase %} pq-purchase__stock--unavailable{% endunless %}">
    <span aria-hidden="true"></span>{% if can_purchase %}{% render 'pq-purchase-copy', key: 'in_stock' %}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}
  </p>
  {% if can_purchase %}
    <product-form-component data-section-id="{{ section.id }}" data-product-id="{{ product.id }}" data-product-url="{{ product.url }}" data-quantity-default="{{ minimum }}" data-quantity-error-max="{{ 'products.product.quantity_error_max' | t }}" on:submit="/handleSubmit">
      <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
      {% form 'product', product, id: form_id, data-type: 'add-to-cart-form' %}
        <input type="hidden" name="id" ref="variantId" value="{{ variant.id }}">
        <div class="pq-purchase__buttons" ref="productFormButtons">
          {% render 'quantity-selector', product: product, variant: variant, can_update_quantity: true, max: maximum %}
          {% assign add_text = 'products.product.add_to_cart' | t %}
          {% assign add_id = 'BuyButtons-ProductSubmitButton-' | append: section.id %}
          {% render 'add-to-cart-button', product: product, can_add_to_cart: can_purchase, add_to_cart_text: add_text, class: 'add-to-cart-button pq-purchase__add', id: add_id %}
          <div class="pq-purchase__checkout" ref="acceleratedCheckoutButtonContainer">{{ form | payment_button }}</div>
        </div>
        <span class="product-form-text__error hidden" ref="addToCartTextError"><span class="svg-wrapper">{{ 'icon-error.svg' | inline_asset_content }}</span></span>
      {% endform %}
    </product-form-component>
  {% else %}
    <div class="pq-purchase__unavailable"><button type="button" disabled>{{ 'products.product.sold_out' | t }}</button></div>
  {% endif %}
  <section class="pq-purchase__payment-section">
    <h2 class="pq-purchase__payment-title">{% render 'pq-purchase-copy', key: 'financing' %}</h2>
    <div class="pq-purchase__payments">
      {% render 'pq-payment-methods', list_only: true %}
    </div>
  </section>
  <details class="pq-purchase__accessories" open>
    <summary>{% render 'pq-purchase-copy', key: 'accessories' %}<span class="pq-purchase__chevron" aria-hidden="true"></span></summary>
    <div class="pq-purchase__accessory-box">
      <ul role="list">
        {% render 'pq-purchase-accessory', name: 'nfc', image: 'pq-accessory-nfc-smart-key-fobs.png' %}
        {% render 'pq-purchase-accessory', name: 'm25', image: 'pq-accessory-m25-connector.png' %}
        {% render 'pq-purchase-accessory', name: 'keys', image: 'pq-accessory-ignition-keys.png' %}
        {% render 'pq-purchase-accessory', name: 'charger', image: 'pq-accessory-battery-charger.png' %}
      </ul>
      <details class="pq-purchase__more">
        <summary><span class="pq-purchase__show-more">{% render 'pq-purchase-copy', key: 'show_more' %}</span><span class="pq-purchase__show-less">{{ 'actions.show_less' | t }}</span></summary>
        <ul role="list">
          {% render 'pq-purchase-accessory', name: 'charging', image: 'pq-accessory-charging-connector.png' %}
          {% render 'pq-purchase-accessory', name: 'tools', image: 'pq-accessory-hex-key-set.png' %}
          {% render 'pq-purchase-accessory', name: 'battery', image: 'pq-accessory-battery.png' %}
        </ul>
      </details>
    </div>
  </details>
  <div class="pq-purchase__policies">
    {% assign policies = 'shipping,price,warranty,legal' | split: ',' %}
    {% for policy in policies %}
      {% assign heading_key = '' | append: policy | append: '_heading' %}
      {% assign body_key = '' | append: policy | append: '_html' %}
      {% assign policy_icon = 'pq-purchase-' | append: policy | append: '.svg' %}
      <details class="pq-purchase__policy">
        <summary><span class="pq-purchase__policy-icon" aria-hidden="true">{{ policy_icon | inline_asset_content }}</span><span>{% render 'pq-purchase-copy', key: heading_key %}</span><span class="pq-purchase__chevron" aria-hidden="true"></span></summary>
        <div class="pq-purchase__policy-body">
          {% if policy == 'shipping' %}
            {% assign shipping_url = pages.tos.url | default: '/pages/tos' | append: '#shipping' %}
            <p>{{ 'content.shipping_policy_html' | t: link: shipping_url }}</p>
          {% else %}
            {% render 'pq-purchase-copy', key: body_key %}
          {% endif %}
        </div>
      </details>
    {% endfor %}
  </div>
</pq-purchase-panel>
