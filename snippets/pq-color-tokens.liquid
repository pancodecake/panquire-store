{% doc %}
  Merchant-editable carbon, bronze and silver palette shared by all pages.
{% enddoc %}
{% style %}
  :root {
    --neutral-950: {{ settings.pq_background | default: '#08090b' }};
    --neutral-900: {{ settings.pq_surface | default: '#151619' }};
    --neutral-700: {{ settings.pq_border | default: '#34363B' }};
    --neutral-300: {{ settings.pq_text_muted | default: '#B8B9BD' }};
    --neutral-100: {{ settings.pq_text | default: '#F3F3F1' }};
    --bronze-600: {{ settings.pq_accent | default: '#A97832' }};
    --bronze-500: #BA8842;
    --bronze-700: #956A2D;
    --bronze-800: #8C6228;
    --silver-300: {{ settings.pq_secondary | default: '#D5D6D8' }};

    --color-bg-page: var(--neutral-950);
    --color-bg-surface: var(--neutral-900);
    --color-text-primary: var(--neutral-100);
    --color-text-secondary: var(--neutral-300);
    --color-border: var(--neutral-700);
    --color-border-strong: #4B4D53;
    --color-focus-ring: var(--silver-300);
    --color-accent-solid: var(--bronze-600);
    --color-accent-solid-hover: var(--bronze-500);
    --color-text-on-accent: var(--neutral-950);
    --color-heading-accent: var(--bronze-600);
    --color-action-solid: var(--bronze-700);
    --color-action-solid-hover: var(--bronze-800);
    --color-text-on-action: #FFFFFF;
    --color-secondary-solid: var(--silver-300);
    --color-text-on-secondary: var(--neutral-950);

    --carbon-base: var(--color-bg-page);
    --carbon-gradient: {{ settings.pq_carbon_gradient | default: 'linear-gradient(135deg, #08090b 0%, #111216 55%, #090a0c 100%)' }};
    --surface: var(--color-bg-surface);
    --text: var(--color-text-primary);
    --text-muted: var(--color-text-secondary);
  }
{% endstyle %}
