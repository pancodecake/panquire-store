{% doc %}
  Renders the labeled campaign simulation for purchasable products.
  @param {boolean} can_purchase - Whether the purchase panel permits purchase.
  @param {boolean} has_stock_without_delivery - Whether stock exists but cannot be shipped.
  @param {string} unavailable_label - Translated unavailability notice.
  @param {boolean} [theme_editor] - Shows the simulation in the editor regardless of availability.
{% enddoc %}

{%- if can_purchase or theme_editor -%}
  {%- assign minimum_demo_stock = 30 -%}
  {%- assign maximum_demo_stock = 250 -%}
  <pq-stock-counter class="pq-purchase__stock pq-stock-counter" data-demo-minimum="{{ minimum_demo_stock }}" data-demo-maximum="{{ maximum_demo_stock }}">
    <div class="pq-stock-counter__panel">
      <p class="pq-stock-counter__heading">Black Friday · Limited Stock</p>
      <p class="pq-stock-counter__mode">Simulated stock and purchases</p>
      <div class="pq-stock-counter__notice-slot">
        <span class="pq-stock-counter__notice"></span>
      </div>
      <p class="pq-stock-counter__number">{{ minimum_demo_stock }}</p>
      <div class="pq-stock-counter__track" aria-hidden="true">
        <div class="pq-stock-counter__fill"></div>
      </div>
      <p class="pq-stock-counter__label">Units Remaining in Stock</p>
    </div>
  </pq-stock-counter>
{%- else -%}
  <p class="pq-purchase__stock pq-purchase__stock--status pq-purchase__stock--unavailable">
    <span aria-hidden="true"></span>
    {%- if has_stock_without_delivery -%}
      {{ 'content.inventory_in_stock' | t }}. {% render 'pq-purchase-copy', key: 'delivery_unavailable' %}
    {%- else -%}
      {{ unavailable_label }}
    {%- endif -%}
  </p>
{%- endif -%}
