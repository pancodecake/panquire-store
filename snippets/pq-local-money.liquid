{%- doc -%}
  Renders a Shopify price and exposes its USD amount for display-only conversion.
  @param {number} amount - Shopify price in minor units.
  @param {boolean} [with_currency] - Include the currency code in the original price.
  @param {string} [formatted] - Existing formatted price text.
{%- enddoc -%}
{%- if amount != blank -%}
  {%- if cart.currency.iso_code == 'USD' -%}<span data-pq-usd-cents="{{ amount }}">{%- endif -%}
  {%- if formatted != blank -%}
    {{- formatted -}}
  {%- elsif with_currency -%}
    {{- amount | money_with_currency -}}
  {%- else -%}
    {{- amount | money -}}
  {%- endif -%}
  {%- if cart.currency.iso_code == 'USD' -%}</span>{%- endif -%}
{%- endif -%}
