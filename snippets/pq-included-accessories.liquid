{% doc %}
Renders the included accessory grid for a Panquire product.

@param {product} product - The current Panquire product.

@example
{% render 'pq-included-accessories', product: product %}
{% enddoc %}

<div class="pq-included-accessories">
  <p class="pq-included-accessories__intro">{{ 'panquire.product_page.accessories_intro' | t }}</p>
  <div class="pq-included-accessories__list" role="list">
    <article class="pq-accessory" role="listitem">
      <span class="pq-accessory__included" aria-hidden="true">{{ 'icon-checkmark.svg' | inline_asset_content }}</span>
      <div class="pq-accessory__media">
        <img src="{{ 'pq-accessory-nfc-smart-key-fobs.png' | asset_url }}" alt="" width="1086" height="1448" loading="lazy" decoding="async">
      </div>
      <div class="pq-accessory__copy">
        <h3>{{ 'panquire.product_page.accessories_nfc_title' | t }}</h3>
        <p>{{ 'panquire.product_page.accessories_nfc_description' | t }}</p>
      </div>
    </article>
    <article class="pq-accessory" role="listitem">
      <span class="pq-accessory__included" aria-hidden="true">{{ 'icon-checkmark.svg' | inline_asset_content }}</span>
      <div class="pq-accessory__media">
        <img src="{{ 'pq-accessory-m25-connector.png' | asset_url }}" alt="" width="1254" height="1254" loading="lazy" decoding="async">
      </div>
      <div class="pq-accessory__copy">
        <h3>{{ 'panquire.product_page.accessories_m25_title' | t }}</h3>
        <p>{{ 'panquire.product_page.accessories_m25_description' | t }}</p>
      </div>
    </article>
    <article class="pq-accessory" role="listitem">
      <span class="pq-accessory__included" aria-hidden="true">{{ 'icon-checkmark.svg' | inline_asset_content }}</span>
      <div class="pq-accessory__media">
        <img src="{{ 'pq-accessory-ignition-keys.png' | asset_url }}" alt="" width="1086" height="1448" loading="lazy" decoding="async">
      </div>
      <div class="pq-accessory__copy">
        <h3>{{ 'panquire.product_page.accessories_ignition_keys_title' | t }}</h3>
        <p>{{ 'panquire.product_page.accessories_ignition_keys_description' | t }}</p>
      </div>
    </article>
    <article class="pq-accessory" role="listitem">
      <span class="pq-accessory__included" aria-hidden="true">{{ 'icon-checkmark.svg' | inline_asset_content }}</span>
      <div class="pq-accessory__media">
        <img src="{{ 'pq-accessory-battery-charger.png' | asset_url }}" alt="" width="1086" height="1448" loading="lazy" decoding="async">
      </div>
      <div class="pq-accessory__copy">
        <h3>{{ 'panquire.product_page.accessories_charger_title' | t }}</h3>
        {% if product.handle == 't-02' %}
          <p>{{ 'panquire.product_page.accessories_charger_t02_description' | t }}</p>
        {% else %}
          <p>{{ 'panquire.product_page.accessories_charger_t01_description' | t }}</p>
        {% endif %}
      </div>
    </article>
    <article class="pq-accessory" role="listitem">
      <span class="pq-accessory__included" aria-hidden="true">{{ 'icon-checkmark.svg' | inline_asset_content }}</span>
      <div class="pq-accessory__media">
        <img src="{{ 'pq-accessory-charging-connector.png' | asset_url }}" alt="" width="1086" height="1448" loading="lazy" decoding="async">
      </div>
      <div class="pq-accessory__copy">
        <h3>{{ 'panquire.product_page.accessories_charging_connector_title' | t }}</h3>
        <p>{{ 'panquire.product_page.accessories_charging_connector_description' | t }}</p>
      </div>
    </article>
    <article class="pq-accessory" role="listitem">
      <span class="pq-accessory__included" aria-hidden="true">{{ 'icon-checkmark.svg' | inline_asset_content }}</span>
      <div class="pq-accessory__media">
        <img src="{{ 'pq-accessory-hex-key-set.png' | asset_url }}" alt="" width="1086" height="1448" loading="lazy" decoding="async">
      </div>
      <div class="pq-accessory__copy">
        <h3>{{ 'panquire.product_page.accessories_hex_keys_title' | t }}</h3>
        <p>{{ 'panquire.product_page.accessories_hex_keys_description' | t }}</p>
      </div>
    </article>
    <article class="pq-accessory" role="listitem">
      <span class="pq-accessory__included" aria-hidden="true">{{ 'icon-checkmark.svg' | inline_asset_content }}</span>
      <div class="pq-accessory__media">
        <img src="{{ 'pq-accessory-battery.png' | asset_url }}" alt="" width="1086" height="1448" loading="lazy" decoding="async">
      </div>
      <div class="pq-accessory__copy">
        <h3>{{ 'panquire.product_page.accessories_battery_title' | t }}</h3>
        {% if product.handle == 't-02' %}
          <p>{{ 'panquire.product_page.accessories_battery_t02_html' | t }}</p>
        {% else %}
          <p>{{ 'panquire.product_page.accessories_battery_t01_html' | t }}</p>
        {% endif %}
      </div>
    </article>
  </div>
</div>

{% stylesheet %}
  .pq-included-accessories {
    padding: 0 0 20px;
  }

  .pq-included-accessories__intro {
    margin: 0 0 13px;
    color: var(--text-muted);
    font-size: 12px;
    line-height: 1.55;
  }

  .pq-included-accessories__list {
    overflow: hidden;
    border: 1px solid var(--pq-line);
    border-radius: 4px;
  }

  .pq-accessory {
    display: grid;
    grid-template-columns: 22px 64px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    min-width: 0;
    min-height: 92px;
    padding: 11px 13px;
    background: #111317;
  }

  .pq-accessory + .pq-accessory {
    border-top: 1px dotted var(--pq-line);
  }

  .pq-accessory__included {
    display: grid;
    width: 20px;
    height: 20px;
    place-items: center;
    border: 1px solid var(--color-action-solid);
    border-radius: 3px;
    background: var(--color-action-solid);
    color: var(--color-text-on-action);
  }

  .pq-accessory__included svg {
    width: 12px;
    height: 12px;
  }

  .pq-accessory__media {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
  }

  .pq-accessory__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .pq-accessory__copy {
    min-width: 0;
  }

  .pq-accessory__copy h3 {
    margin: 0 0 4px;
    color: var(--color-heading-accent);
    font-family: var(--pq-heading-font);
    font-size: 12px;
    line-height: 1.3;
  }

  .pq-accessory__copy p {
    margin: 0;
    color: var(--text-muted);
    font-size: 10px;
    line-height: 1.45;
  }

  .pq-accessory__copy strong {
    color: var(--text);
    font-weight: 700;
  }

  @media (max-width: 420px) {
    .pq-accessory {
      grid-template-columns: 18px 52px minmax(0, 1fr);
      gap: 9px;
      min-height: 80px;
      padding: 9px;
    }

    .pq-accessory__media {
      width: 52px;
      height: 52px;
    }

    .pq-accessory__included {
      width: 18px;
      height: 18px;
    }
  }
{% endstylesheet %}
