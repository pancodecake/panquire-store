{% doc %}
  T-01 range and buying guide for the English storefront.
  @param {product} product - Current T-01 product.
{% enddoc %}
{% assign guide_image = images['panquire-t01_outside_pavement.jpg'] | default: product.featured_image %}
{% assign guide_variant = product.selected_or_first_available_variant %}
{{ 'pq-buying-guide.css' | asset_url | stylesheet_tag }}
<section class="pq-buying-guide pq-buying-guide__product pq-t01-guide">
  {% if guide_image != blank %}
    <div class="pq-t01-guide__media">
      {{ guide_image | image_url: width: 1920 | image_tag: widths: '360, 540, 750, 990, 1320, 1600, 1920', sizes: '(min-width: 1116px) 1020px, (min-width: 990px) calc(100vw - 96px), (min-width: 600px) calc(100vw - 48px), calc(100vw - 40px)', loading: 'lazy', decoding: 'async', alt: 'Black and gold Panquire T-01 electric dirt bike' }}
    </div>
  {% endif %}
  <div class="pq-t01-guide__body">
    <p class="pq-t01-guide__eyebrow">Electric dirt bike range</p>
    <h2>A 60V electric dirt bike with up to 80 km in Eco mode</h2>
    <p>The removable 60V 31.2Ah battery stores 1,872 Wh of nominal energy. Take it out to charge it near an outlet. Panquire states up to 80 km (about 50 miles) in Eco mode. Actual range depends on terrain, speed, rider weight, temperature, and riding style.</p>
    <p class="pq-t01-guide__capacity"><strong>1,872 Wh</strong> <span>Nominal battery capacity</span></p>
    <dl class="pq-t01-guide__specs">
      <div><dt>Battery</dt><dd>60V 31.2Ah, removable</dd></div>
      <div><dt>Top speed</dt><dd>80 km/h stated</dd></div>
      <div><dt>Bike weight</dt><dd>55 kg</dd></div>
    </dl>
    {% if cart.currency.iso_code == 'USD' and product.variants.size == 1 and guide_variant.available and guide_variant.price < 200000 %}
      <p>Looking for an electric dirt bike for sale under US$2,000? The T-01 is listed at {{ guide_variant.price | money_with_currency }} before applicable taxes and duties.</p>
    {% endif %}
    <div class="pq-buying-guide__links">
      <a href="{{ pages.compare.url | default: '/pages/compare' }}">Compare electric dirt bike specifications</a>
      <a href="{{ pages.contact.url | default: '/pages/contact' }}">Ask about rider fit</a>
    </div>
  </div>
</section>
