{% doc %}
  Render a curated Shopify file image, falling back to the product's own primary image.
  @param {product} product - Current product
  @param {string} media_id - Numeric Shopify media identifier
  @param {string} alt - Descriptive alternative text
{% enddoc %}
{% liquid
  assign chosen_image = product.featured_image
  for item in product.metafields.panquire.gallery_media.value
    assign identifier = item.id | append: ''
    if identifier == media_id
      assign chosen_image = item.preview_image
      break
    endif
  endfor
%}
{% if chosen_image %}
  {{ chosen_image | image_url: width: 1600 | image_tag: widths: '400,600,800,1200,1600', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', alt: alt }}
{% endif %}
