{% doc %}
  Renders the searchable country selector in the Panquire header.
  @param {string} section_id - ID of the header section.
{% enddoc %}
{% liquid
  assign countries = localization.available_countries | sort_natural: 'name'
  assign country_count = countries.size
  assign batches = country_count | divided_by: 50.0 | ceil
  assign form_id = 'HeaderLocation-' | append: section_id
  assign active_country = localization.country
%}
{% if country_count > 1 %}
  <details class="pq-header-location" data-header-location>
    <summary class="pq-header-location__trigger">
      <span class="pq-header-location__copy">
        <span class="pq-header-location__label">{{ 'accessibility.country_region' | t }}</span>
        <span class="pq-header-location__selected">
          {{ active_country | image_url: width: 48 | image_tag: width: 20, height: 20, class: 'pq-header-location__flag', alt: '' }}
          <span data-location-name>{{ active_country.name | replace: '&amp;', '&' | escape }}</span>
        </span>
      </span>
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </summary>
    {% form 'localization', id: form_id, class: 'pq-header-location__panel' %}
      <div class="pq-header-location__search" data-location-search hidden>
        {% render 'pq-icon', name: 'search' %}
        <label class="visually-hidden" for="{{ form_id }}-search">{{ 'accessibility.find_country' | t }}</label>
        <input id="{{ form_id }}-search" type="search" autocomplete="off" placeholder="{{ 'panquire.search' | t | escape }}" aria-controls="{{ form_id }}-countries">
      </div>
      <ul class="pq-header-location__countries" id="{{ form_id }}-countries" role="list">
        {% for batch in (1..batches) %}
          {% assign country_offset = forloop.index0 | times: 50 %}
          {% for country in countries offset: country_offset limit: 50 %}
            {% assign currency_code = country.currency.iso_code | default: shop.currency %}
            {% assign currency_symbol = country.currency.symbol %}
            {% if currency_symbol == blank and currency_code == 'USD' %}
              {% assign currency_symbol = '$' %}
            {% endif %}
            <li>
              <button type="submit" name="country_code" value="{{ country.iso_code | escape }}" class="pq-header-location__option" data-currency="{{ currency_code | escape }}"{% if country.iso_code == active_country.iso_code %} aria-current="true"{% endif %}>
                {{ country | image_url: width: 48 | image_tag: width: 24, height: 24, class: 'pq-header-location__flag', alt: '', loading: 'lazy' }}
                <span>{{ country.name | replace: '&amp;', '&' | escape }}</span>
                <span class="pq-header-location__currency">{{ currency_code | escape }}{% if currency_symbol != blank %} / {{ currency_symbol | escape }}{% endif %}</span>
              </button>
            </li>
          {% endfor %}
        {% endfor %}
      </ul>
      <button type="button" class="pq-header-location__full" data-location-full aria-controls="{{ form_id }}-countries" aria-expanded="false" hidden>Full Location List</button>
      <p class="pq-header-location__empty" role="status" data-location-empty hidden>{{ 'content.no_results_found' | t }}</p>
    {% endform %}
  </details>
  <script src="{{ 'pq-header-location.js' | asset_url }}" type="module"></script>
{% endif %}

{% stylesheet %}
  .pq-header-location {
    position: relative;
    --location-surface: #151619;
    --location-text: #f3f3f1;
    --location-muted: #bcbdc2;
    --location-line: #414349;
    --location-gold: #df9f44;
    --location-transition: 220ms var(--pq-ease-out);
    color: var(--location-text);
    font-family: var(--pq-body-font);
    font-size: 14px;
  }

  .pq-header-location__trigger {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 44px;
    width: 170px;
    padding: 4px 10px;
    list-style: none;
    cursor: pointer;
    border: 1px solid var(--location-line);
    border-radius: 12px;
    background: linear-gradient(135deg, color-mix(in srgb, var(--location-surface) 96%, white), var(--location-surface));
    box-shadow: inset 0 1px rgb(255 255 255 / .05);
    transition: border-color 220ms ease, box-shadow 220ms ease, border-radius 220ms ease, color 180ms ease;
  }

  .pq-header-location__trigger::-webkit-details-marker { display: none; }
  .pq-header-location[data-location-pending] {
    --location-transition: 150ms var(--pq-ease-out);
  }
  .pq-header-location[data-location-pending] .pq-header-location__trigger {
    border-color: var(--location-gold);
    cursor: progress;
  }
  .pq-header-location[data-location-pending] .pq-header-location__trigger > svg {
    visibility: hidden;
    transition: visibility 0s linear 150ms;
  }
  .pq-header-location[data-location-pending] .pq-header-location__trigger::before {
    content: '';
    position: absolute;
    inset-inline-end: 12px;
    width: 12px;
    height: 12px;
    border: 1.5px solid var(--location-line);
    border-block-start-color: var(--location-gold);
    border-radius: 50%;
    opacity: 0;
    animation: pq-location-wait 650ms linear 150ms infinite;
  }
  @keyframes pq-location-wait {
    from { opacity: 1; transform: rotate(0deg); }
    to { opacity: 1; transform: rotate(360deg); }
  }
  .pq-header-location__trigger::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--location-gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--location-transition);
  }

  .pq-header-location__trigger > svg { flex: none; transition: transform var(--location-transition), color 180ms ease; }
  .pq-header-location[open] .pq-header-location__trigger { border-color: var(--location-line); border-radius: 12px 12px 8px 8px; color: var(--location-surface); }
  .pq-header-location[open] .pq-header-location__trigger::after { transform: scaleX(1); transform-origin: right; }
  .pq-header-location[open] .pq-header-location__trigger > svg { transform: rotate(180deg); color: inherit; }
  .pq-header-location[open] .pq-header-location__label { color: inherit; }
  .pq-header-location__copy { display: grid; min-width: 0; gap: 2px; }
  .pq-header-location__label { color: var(--location-muted); font-size: 10px; line-height: 1.1; }
  .pq-header-location__selected { display: flex; align-items: center; min-width: 0; gap: 7px; font-size: 12px; font-weight: 600; }
  .pq-header-location__selected > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pq-header-location img.pq-header-location__flag {
    flex: none;
    inline-size: 24px;
    block-size: 24px;
    border-radius: 50%;
    object-fit: cover;
  }

  .pq-header-location__selected img.pq-header-location__flag {
    inline-size: 20px;
    block-size: 20px;
  }

  .pq-header-location__panel {
    position: absolute;
    z-index: 5;
    inset-block-start: calc(100% + 8px);
    inset-inline-end: 0;
    width: min(360px, calc(100vw - 32px));
    padding: 8px;
    border: 1px solid var(--location-line);
    border-radius: 17px;
    background: var(--location-surface);
    color: var(--location-text);
    box-shadow: 0 24px 60px rgb(0 0 0 / .38), inset 0 1px rgb(255 255 255 / .05);
    transform-origin: top;
  }

  .pq-header-location[open] .pq-header-location__panel {
    animation: pq-location-open var(--location-transition) both;
  }

  @keyframes pq-location-open {
    from { opacity: 0; transform: translateY(-9px) scale(.985); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  @supports selector(details::details-content) {
    .pq-header-location::details-content {
      transition: content-visibility var(--location-transition) allow-discrete;
    }
    .pq-header-location .pq-header-location__panel {
      animation: none;
      opacity: 0;
      transform: translateY(-9px) scale(.985);
      pointer-events: none;
      transition: opacity 190ms ease, transform var(--location-transition);
    }
    .pq-header-location[open] .pq-header-location__panel {
      animation: none;
      opacity: 1;
      transform: translateY(0) scale(1);
      pointer-events: auto;
    }
  }

  .pq-header-location__search {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-inline: 10px;
    margin-block-end: 6px;
    border: 1px solid var(--location-line);
    border-radius: 5px;
  }

  .pq-header-location__search:focus-within { border-color: var(--location-gold); }
  .pq-header-location__search svg { width: 19px; height: 19px; flex: none; }
  .pq-header-location__search input {
    width: 100%;
    min-height: 42px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 16px;
    color-scheme: dark;
  }

  .pq-header-location__search input::placeholder { color: var(--location-muted); }
  .pq-header-location__countries {
    display: grid;
    gap: 2px;
    max-height: min(50dvh, 390px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--location-muted) transparent;
    margin: 0;
    padding: 2px;
    list-style: none;
  }

  .pq-header-location__option {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    width: 100%;
    min-height: 44px;
    padding: 7px 10px;
    border: 1px solid transparent;
    border-radius: 10px;
    background: transparent;
    color: var(--location-text);
    font: inherit;
    text-align: start;
    cursor: pointer;
    transition: background-color 180ms ease, border-color 180ms ease;
  }

  .pq-header-location__option::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: color-mix(in srgb, var(--location-gold) 15%, var(--location-surface));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--location-transition);
  }

  .pq-header-location__currency { justify-self: end; white-space: nowrap; color: var(--location-muted); font-size: 12px; }
  .pq-header-location__option[aria-current="true"] { border-color: color-mix(in srgb, var(--location-gold) 60%, var(--location-line)); background: color-mix(in srgb, var(--location-gold) 12%, var(--location-surface)); }
  .pq-header-location__option:is(:focus-visible, :active)::before { transform: scaleX(1); transform-origin: right; }
  .pq-header-location__full {
    width: 100%;
    min-height: 44px;
    margin-block-start: 6px;
    border: 0;
    border-block-start: 1px solid var(--location-line);
    background: transparent;
    color: var(--location-gold);
    font: inherit;
    text-underline-offset: 4px;
  }
  .pq-header-location__empty { margin: 0; padding: 12px 10px; color: var(--location-muted); }

  @media (hover: hover) {
    .pq-header-location__trigger:hover { border-color: var(--location-gold); box-shadow: 0 0 0 3px rgb(223 159 68 / .09), inset 0 1px rgb(255 255 255 / .07); }
    .pq-header-location__option:hover::before { transform: scaleX(1); transform-origin: right; }
    .pq-header-location__full:hover { text-decoration: underline; }
  }

  .pq-header-location :is(summary, button):focus-visible {
    outline: 2px solid var(--location-gold);
    outline-offset: 1px;
  }

  .pq-header-location .pq-header-location__search input:focus-visible { outline: none; }

  @media (max-width: 1140px) {
    .pq-header-location { position: static; }
    .pq-header-location__panel { inset-block-start: calc(100% + 4px); inset-inline-end: var(--pq-content-gutter); }
  }

  @media (max-width: 380px) {
    .pq-header-location__trigger { width: min(150px, calc(100vw - 208px)); gap: 4px; padding-inline: 6px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pq-header-location::details-content { transition: none; }
    .pq-header-location[data-location-pending] .pq-header-location__trigger::before { animation: none; opacity: 1; }
    .pq-header-location__trigger,
    .pq-header-location__trigger::after,
    .pq-header-location__trigger > svg,
    .pq-header-location__panel,
    .pq-header-location__option,
    .pq-header-location__option::before {
      animation: none !important;
      transition: none !important;
    }
  }
{% endstylesheet %}
