{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="theme-color"
  content=""
>

{%- liquid
  assign site_name = settings.pq_store_name | default: 'Panquire'
  assign og_title = page_title | default: site_name
  assign seo_canonical_url = canonical_url
  if request.page_type == 'page'
    assign canonical_policy_url = nil
    case page.handle
      when 'terms'
        assign canonical_policy_url = shop.terms_of_service.url
      when 'refund-return'
        assign canonical_policy_url = shop.refund_policy.url
    endcase
    if canonical_policy_url != blank
      assign seo_canonical_url = canonical_policy_url | prepend: request.origin
    endif
  endif
  if request.page_type == 'search'
    assign search_terms = search.terms | strip
    if search_terms == blank
      assign seo_canonical_url = request.origin | append: routes.search_url
    endif
  endif
  assign og_url = seo_canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: 'Panquire electric dirt bikes for off-road riding.'
  assign document_title = page_title
  assign seo_language = request.locale.iso_code | slice: 0, 2

  if seo_language == 'en'
  if request.page_type == 'product' and product.handle == 't-03'
    assign document_title = 'Panquire T-03 Mini Electric Motorcycle | 9.5 kW Peak'
    assign og_description = 'Meet the Panquire T-03 mini electric motorcycle with 12-inch Kenda road tires, 9.5 kW peak power and a removable 60V 31.2Ah battery.'
  elsif request.page_type == 'product' and product.handle == 't-01'
    assign document_title = 'Panquire T-01 | 60V Electric Dirt Bike'
    assign og_description = 'Explore the Panquire T-01 60V electric dirt bike with a removable 31.2Ah battery and 9.5 kW peak output. Compare specifications, rider fit and ownership.'
  elsif request.page_type == 'product' and product.handle == 't-02'
    assign document_title = 'Panquire T-02 | 72V Electric Dirt Bike with 13 kW Peak'
    assign og_description = 'Explore the Panquire T-02 72V electric dirt bike with 13 kW peak power, a removable 41Ah battery and up to 90 km of stated Eco range. Compare price and fit.'
  elsif page.handle == 'about'
    assign document_title = 'About Panquire | Electric Dirt Bikes & Motorcycles'
    assign og_description = 'Meet Panquire, the company behind the T-01 and T-02 electric dirt bikes and the T-03 mini electric motorcycle. Explore the lineup and contact our team.'
  elsif page.handle == 'contact'
    assign document_title = 'Contact Panquire | Orders, Parts & Warranty'
    assign og_description = 'Contact Panquire for help with your electric dirt bike or motorcycle, including orders, rider fit, parts, warranty, sales and dealer inquiries.'
  elsif page.handle == 'compare'
    assign document_title = 'Sur-Ron Alternatives & Dirt Bike Comparison | Panquire'
    assign og_description = 'Considering a Sur-Ron alternative? Compare Panquire electric dirt bikes with other models using manufacturer specifications, current sources and clear tradeoffs.'
  endif
  endif
  assign og_title = document_title | default: site_name

  if seo_language == 'en'
  if request.page_type == 'index'
    assign document_title = 'Panquire Electric Dirt Bikes & Motorcycles'
    assign og_title = document_title
    assign og_description = 'Compare Panquire’s T-01 and T-02 electric dirt bikes and the T-03 mini electric motorcycle. Explore battery, range, rider fit and support before you buy.'
  endif
  endif

  if seo_language == 'en' and request.page_type == 'page' and page.handle == 'terms' and page_description.size > 160
    assign og_description = 'Read Panquire’s terms of purchase for electric dirt bikes and motorcycles, including orders, payment, delivery, returns, warranty and consumer rights.'
  endif

  if seo_language == 'en' and page_description == blank
    case request.page_type
      when 'search'
        assign og_description = 'Search the Panquire lineup of electric dirt bikes and mini electric motorcycles by model or keyword.'
      when 'cart'
        assign og_description = 'Review the Panquire items in your shopping cart and update quantities before checking out.'
      when 'collection'
        if collection.handle == 'all'
          assign og_description = 'Browse Panquire electric dirt bikes and mini electric motorcycles, including the T-01, T-02 and T-03.'
        endif
      when 'page'
        case page.handle
          when 'partners'
            assign og_description = 'Explore Panquire dealer, fleet, affiliate and business partnership opportunities, and find out how to get in touch.'
          when 'tos'
            assign og_description = 'Read Panquire’s terms of service covering orders, payment, shipping, returns and warranty support.'
        endcase
      when 'policy'
        assign policy_handle = request.path | split: '/' | last
        case policy_handle
          when 'terms-of-service'
            assign og_description = 'Read Panquire’s terms of purchase for electric dirt bikes and motorcycles, including orders, payment, delivery, returns, warranty and consumer rights.'
          when 'shipping-policy'
            assign og_description = 'Read Panquire’s shipping policy for delivery destinations, shipping costs, tracking and order delivery information.'
          when 'refund-policy'
            assign og_description = 'Read the Panquire return and refund policy for eligibility, how to request a return, and what happens after a return is received.'
          when 'privacy-policy'
            assign og_description = 'Learn how Panquire handles personal information when you browse or order, and how to contact us about your privacy rights.'
          when 'contact-information'
            assign og_description = 'Find Panquire’s seller information, business address and customer support contact details.'
        endcase
    endcase
  endif

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}
{% if request.page_type == 'collection' or request.page_type == 'list-collections' or request.page_type == 'search' or request.page_type == 'cart' %}
  <meta name="robots" content="noindex, follow">
{% endif %}

<meta
  property="og:site_name"
  content="{{ site_name | escape }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  {% capture sale_price %}{% render 'pq-black-friday-sale-cents', amount: product.price, product_handle: product.handle %}{% endcapture %}
  <meta
    property="og:price:amount"
    content="{{ sale_price | default: product.price | divided_by: 100.0 }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ document_title | escape }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless document_title contains site_name %} &ndash; {{ site_name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ seo_canonical_url | escape }}"
>

{% if og_description != blank %}
  <meta
    name="description"
    content="{{ og_description | escape }}"
  >
{% endif %}
