{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="theme-color"
  content=""
>

{%- liquid
  assign site_name = settings.pq_store_name | default: 'Panquire'
  assign og_title = page_title | default: site_name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: 'Panquire electric dirt bikes for off-road riding.'
  assign document_title = page_title
  assign seo_language = request.locale.iso_code | slice: 0, 2

  if seo_language == 'en'
  if request.page_type == 'collection' and collection.handle == 'electric-dirt-bikes'
    assign document_title = 'Electric Dirt Bikes for Adults | Panquire T-01 & T-02'
    assign og_description = 'Compare Panquire electric dirt bikes for adults. Explore the 60V T-01 and 72V T-02, current prices, battery capacity, rider fit and ownership details.'
  elsif request.page_type == 'product' and product.handle == 't-01'
    assign document_title = 'Panquire T-01 | 60V Electric Dirt Bike'
    assign og_description = 'Explore the Panquire T-01 60V electric dirt bike with a removable 31.2Ah battery and 9.5 kW peak output. Compare specifications, rider fit and ownership.'
  elsif request.page_type == 'product' and product.handle == 't-02'
    assign document_title = 'Panquire T-02 | 72V Electric Dirt Bike'
    assign og_description = 'Explore the Panquire T-02 72V electric dirt bike with a removable 41Ah battery and 13 kW peak output. Compare specifications, charging and ownership.'
  elsif page.handle == 'compare'
    assign document_title = 'Sur-Ron Alternatives & Electric Dirt Bike Comparisons | Panquire'
    assign og_description = 'Considering a Sur-Ron alternative? Compare Panquire electric dirt bikes with other models using manufacturer specifications, current sources and clear tradeoffs.'
  endif
  endif
  assign og_title = document_title | default: site_name

  if seo_language == 'en'
  if request.page_type == 'index' or page_title == 'My Store'
    assign document_title = 'Panquire | Electric Dirt Bikes & Mini Electric Motorcycles'
    assign og_title = document_title
    assign og_description = 'Explore Panquire electric dirt bikes and mini electric motorcycles. Compare T-01 and T-02 off-road models, battery systems, current prices and ownership details.'
  endif
  endif

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ site_name | escape }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ document_title | escape }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless document_title contains site_name %} &ndash; {{ site_name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if og_description != blank %}
  <meta
    name="description"
    content="{{ og_description | escape }}"
  >
{% endif %}
