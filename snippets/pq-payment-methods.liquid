{% doc %}
  Renders the card brands requested for Panquire's Oceanpayment review.
  @param {string} [class] - Optional additional class name.
  @param {boolean} [list_only] - Renders just the card list inside an existing payment panel.
{% enddoc %}
{% assign payment_types = 'visa,master,maestro,jcb,american_express,diners_club,discover' | split: ',' %}
{% unless list_only %}
  <div class="pq-payment-methods pq-footer-payment-icons{% if class != blank %} {{ class }}{% endif %}" aria-label="{{ 'blocks.payment_methods' | t | escape }}">
    <span class="pq-payment-methods__label">{{ 'blocks.payment_methods' | t }}</span>
{% endunless %}
  <ul class="pq-payment-methods__list{% if list_only %} pq-footer-payment-icons{% endif %}" role="list">
    {% for type in payment_types %}
      <li>{{ type | payment_type_svg_tag: class: 'pq-payment-methods__icon' }}</li>
    {% endfor %}
  </ul>
{% unless list_only %}
  </div>
{% endunless %}

{% stylesheet %}
  .pq-payment-methods {
    display: grid;
    gap: 8px;
  }

  .pq-payment-methods__label {
    color: currentColor;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pq-payment-methods__list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pq-payment-methods__list li {
    display: flex;
  }

  .pq-payment-methods__icon {
    width: 38px;
    height: 24px;
  }

  .pq-payment-methods--footer {
    color: var(--pq-muted);
    margin-block-start: 4px;
  }
{% endstylesheet %}
