{% doc %}
  Renders payment icons for methods that are enabled in Shopify.
  @param {string} [class] - Optional additional class name.
{% enddoc %}
{% if shop.enabled_payment_types != empty %}
  <div class="pq-payment-methods{% if class != blank %} {{ class }}{% endif %}" aria-label="{{ 'blocks.payment_methods' | t | escape }}">
    <span class="pq-payment-methods__label">{{ 'blocks.payment_methods' | t }}</span>
    <ul class="pq-payment-methods__list" role="list">
      {% for type in shop.enabled_payment_types %}
        <li>{{ type | payment_type_svg_tag: class: 'pq-payment-methods__icon' }}</li>
      {% endfor %}
    </ul>
  </div>
{% endif %}

{% stylesheet %}
  .pq-payment-methods {
    display: grid;
    gap: 8px;
  }

  .pq-payment-methods__label {
    color: currentColor;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pq-payment-methods__list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pq-payment-methods__list li {
    display: flex;
  }

  .pq-payment-methods__icon {
    width: 38px;
    height: 24px;
  }

  .pq-payment-methods--footer {
    color: var(--pq-muted);
    margin-block-start: 4px;
  }
{% endstylesheet %}
