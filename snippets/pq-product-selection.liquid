{% doc %}
  Model-specific buying context and links, preserving product metafield content.
  @param {product} product - Current product.
{% enddoc %}
{% if request.locale.iso_code == 'en' %}
{% if product.handle == 't-01' %}
  {% render 'pq-t01-buying-guide', product: product %}
{% elsif product.handle == 't-02' %}
  {% render 'pq-t02-buying-guide', product: product %}
{% elsif product.handle == 't-03' %}
  {{ 'pq-buying-guide.css' | asset_url | stylesheet_tag }}
  <section class="pq-buying-guide pq-buying-guide__product">
    <h2>{{ 'panquire.storefront.a_compact_mini_electric_motorcycle' | t | escape }}</h2>
    <p>{{ 'panquire.storefront.the_panquire_t_03_uses_12_inch' | t | escape }}</p>
    <p>{{ 'panquire.storefront.the_t_03_is_designed_for_paved' | t | escape }} <a href="{{ all_products['t-01'].url }}">T-01</a> {{ 'panquire.storefront.or' | t | escape }} <a href="{{ all_products['t-02'].url }}">{{ 'panquire.storefront.t_02_electric_dirt_bike' | t | escape }}</a>{{ 'panquire.storefront.check_your_local_rules_for_vehicle_classification' | t | escape }}</p>
  </section>
{% endif %}
{% endif %}
