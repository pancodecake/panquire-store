{%- capture sale -%}{% render 'pq-black-friday-sale-cents', amount: product.price, product_handle: product.handle %}{%- endcapture -%}
{%- if sale == blank -%}
  {{ product | structured_data }}
{%- else -%}
  {%- assign product_url = request.origin | append: product.url -%}
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "@id": {{ product_url | append: '#product' | json }},
    "url": {{ product_url | json }},
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | json }},
    "image": {{ product.featured_image | image_url: width: 1600 | prepend: 'https:' | json }},
    "brand": {"@type": "Brand", "name": {{ product.vendor | json }}},
    "offers": [
      {%- for variant in product.variants -%}
        {%- capture variant_sale -%}{% render 'pq-black-friday-sale-cents', amount: variant.price, product_handle: product.handle %}{%- endcapture -%}
        {
          "@type": "Offer",
          "url": {{ product_url | append: '?variant=' | append: variant.id | json }},
          "sku": {{ variant.sku | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "price": {{ variant_sale | default: variant.price | divided_by: 100.0 | json }},
          {% if variant_sale != blank %}"priceValidUntil": "2026-12-31",{% endif %}
          "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}"
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
{%- endif -%}
