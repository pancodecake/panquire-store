    {%- endcapture -%}
    {%- if field == 'rows' -%}{{ rows }}
    {%- else -%}
      {%- assign entries = rows | newline_to_br | split: '<br />' -%}
      {%- for entry in entries -%}
        {%- assign cells = entry | strip | split: '|' -%}
        {%- if cells[1] == field -%}{{ cells[2] }}{%- break -%}{%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
