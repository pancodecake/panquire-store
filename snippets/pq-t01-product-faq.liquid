{% assign faqs = 'faq_t01_1,faq_t01_2,faq_t01_3,faq_t01_4,faq_t01_5,faq_t01_6,faq_t01_7,faq_t01_8' | split: ',' %}
{%- assign contact_url = pages.contact.url | default: '/pages/contact' -%}
<section class="pq-product-faq pq-product-faq--t01">
  <h2>{{ 'panquire.product_page.faqs' | t }}</h2>
  <div class="pq-policy-questions">
  {% for faq in faqs %}

    <details class="pq-policy-question" name="ProductFaq-{{ section.id }}">
      <summary><h3>{{ faq | append: '_question' | prepend: 'panquire.storefront.' | t | escape_once }}</h3><span class="pq-policy-toggle" aria-hidden="true"></span></summary>
      <div class="pq-prose pq-policy-answer">
        <p>{{ faq | append: '_answer_html' | prepend: 'panquire.storefront.' | t: contact_url: contact_url }}</p>
      </div>
    </details>
  {% endfor %}
  </div>
</section>
