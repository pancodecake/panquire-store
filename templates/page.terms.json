            "heading": "Warranty",
            "anchor": "warranty"
          },
          "blocks": {
            "warranty_1": {
              "type": "pq-policy-question",
              "settings": {
                "question": "How long is the limited commercial warranty?",
                "answer": "<p>Panquire provides a one-year limited commercial warranty from delivery, subject to the applicable written warranty terms.</p>"
              },
              "blocks": {}
            },
            "warranty_2": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What is covered?",
                "answer": "<p>The limited commercial warranty covers the battery, motor and controller of the T-01, T-02 and T-03. Applicable statutory rights and any additional written coverage also apply.</p>"
              },
              "blocks": {}
            },
            "warranty_3": {
              "type": "pq-policy-question",
              "settings": {
                "question": "How do I submit a warranty claim?",
                "answer": "<p>Email <a href=\"mailto:support@panquire.com\">support@panquire.com</a> with proof of purchase, the model, order number and a description of the issue. Include relevant photos or diagnostic details where available.</p>"
              },
              "blocks": {}
            },
            "warranty_4": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What is excluded from the commercial warranty?",
                "answer": "<p>The commercial warranty generally excludes normal wear and damage due to accident, misuse, improper maintenance or incompatible or unauthorized modifications, subject to applicable law. Tires, brake pads and chains are examples of wear items.</p>"
              },
              "blocks": {}
            },
            "warranty_5": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What remedies are available for a defective product?",
                "answer": "<p>Depending on the circumstances and applicable law, Panquire may offer a repair, replacement, price reduction or refund. See the warranty and statutory remedies section of the <a href=\"/pages/terms\">Terms and Conditions</a>.</p>"
              },
              "blocks": {}
            },
            "warranty_6": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Do statutory consumer rights still apply?",
                "answer": "<p>Yes. The commercial warranty adds to the mandatory rights available under applicable law. Eligible EU consumers generally have a legal guarantee of at least two years for new goods.</p>"
              },
              "blocks": {}
            },
            "warranty_7": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Can I ride on public roads?",
                "answer": "<p>Road use depends on the model configuration and local approval, registration, licensing, insurance and equipment requirements. Read the product manual and check the requirements where you intend to ride.</p>"
              },
              "blocks": {}
            }
          },
