        },
        "shipping": {
          "type": "pq-policy-category",
          "settings": {
            "heading": "Shipping",
            "anchor": "shipping"
          },
          "blocks": {
            "shipping_1": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Where do you currently ship?",
                "answer": "<p>We currently ship to eligible addresses on the <strong>U.S. West Coast</strong> and within <strong>Germany and Poland</strong>.</p><p>Destination availability will be confirmed at checkout.</p><p>Certain remote destinations or locations that cannot be served safely, legally, or reliably may be unavailable.</p>"
              },
              "blocks": {}
            },
            "shipping_2": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Which shipping carriers do you use?",
                "answer": "<p>We primarily use <strong>FedEx</strong>.</p><p>Depending on the product, destination, shipment size, weight, and transportation requirements, an order may be shipped by parcel/express service or by an appropriate freight service.</p>"
              },
              "blocks": {}
            },
            "shipping_3": {
              "type": "pq-policy-question",
              "settings": {
                "question": "How are complete electric motorcycles shipped?",
                "answer": "<p>Complete electric off-road motorcycles may be transported by <strong>express shipping or freight</strong>, depending on the model, destination, dimensions, weight, and applicable transportation requirements.</p><p>The selected shipping method and available tracking information will be provided after dispatch.</p>"
              },
              "blocks": {}
            },
            "shipping_4": {
              "type": "pq-policy-question",
              "settings": {
                "question": "How are lithium-ion batteries shipped?",
                "answer": "<p>Lithium-ion batteries are subject to additional dangerous-goods transportation requirements.</p><p>Battery shipments are prepared and handled in accordance with the applicable transportation rules for the shipment and destination.</p><p>Where required, the relevant supporting documentation will be maintained or obtained, including the applicable <strong>UN 38.3 test summary</strong> for the battery design.</p>"
              },
              "blocks": {}
            },
            "shipping_5": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Will I receive tracking information?",
                "answer": "<p>Yes.</p><p>Once your order has been dispatched and tracking becomes available, we will send you a shipping confirmation containing your tracking number or shipment-tracking information.</p><p>Freight shipments may use a different tracking system from standard parcel shipments.</p>"
              },
              "blocks": {}
            },
            "shipping_6": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What should I do if my order is delayed, lost, or marked as delivered but has not arrived?",
                "answer": "<p>Contact [Store Name] as soon as possible through <strong>[support email / support form]</strong> and provide your order number and tracking information.</p><p>We will review the shipment and, where appropriate, open or coordinate a claim with the carrier or shipping insurer.</p><p>You may be asked to provide additional information or cooperate with the carrier's investigation.</p><p>If the shipment is confirmed lost, we will provide an appropriate replacement, refund, or other resolution in accordance with this policy and applicable law.</p>"
              },
              "blocks": {}
            },
            "shipping_7": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What should I do if my motorcycle or package arrives damaged?",
                "answer": "<p>Do not discard the shipping carton, pallet, protective materials, shipping labels, or included documentation.</p><p>Before operating or charging the product, take clear photographs and/or video showing:</p><ul><li>the exterior packaging;</li><li>the shipping label;</li><li>the complete product;</li><li>the battery;</li><li>and each visibly damaged area.</li></ul><p>Where possible, note visible damage with the carrier at the time of delivery.</p><p>Contact [Store Name] immediately through <strong>[support email / claim form]</strong>.</p><p>After reviewing the claim, we may arrange replacement parts, repair, return, product replacement, refund, or another appropriate remedy.</p>"
              },
              "blocks": {}
            },
            "shipping_8": {
              "type": "pq-policy-question",
              "settings": {
                "question": "How long do I have to report visible shipping damage?",
                "answer": "<p>Please report visible shipping damage within <strong>3 calendar days of delivery whenever reasonably possible</strong>.</p><p>Prompt reporting allows us to properly document the damage and pursue the carrier or shipping-insurance claim.</p><p>Failure to report damage within this requested period does not limit any warranty or statutory consumer rights that cannot legally be waived.</p>"
              },
              "blocks": {}
            },
            "shipping_9": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What evidence is required for a shipping-damage claim?",
                "answer": "<p>Please provide:</p><ul><li>your order number;</li><li>shipment or tracking information;</li><li>photographs or video of the outer packaging;</li><li>photographs or video of the complete product;</li><li>clear evidence of each damaged area;</li><li>and any additional information reasonably required to verify the claim.</li></ul><p>Please retain the original packaging until the claim has been resolved.</p>"
              },
              "blocks": {}
            },
            "shipping_10": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Who pays return shipping?",
                "answer": "<p>For an eligible <strong>change-of-mind or non-quality return</strong>, the customer is responsible for return shipping.</p><p>For a <strong>confirmed defective product</strong>, <strong>incorrect product</strong>, or <strong>confirmed shipping-damaged product</strong>, [Store Name] will cover the applicable return-shipping cost.</p>"
              },
              "blocks": {}
            },
            "shipping_11": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Safety and compliance documentation",
                "answer": "<p>Any safety, compliance, certification, or testing claim displayed by [Store Name] applies only where we hold appropriate supporting documentation for the specific product or component.</p><p>Examples may include, where applicable:</p><ul><li>UN 38.3 battery transportation testing;</li><li>applicable CE documentation;</li><li>applicable battery or electrical-system certification;</li><li>manufacturer authorization;</li><li>and published warranty documentation.</li></ul><p>We do not use certification or safety claims for products that are not supported by the required documentation.</p>"
              },
              "blocks": {}
            },
            "shipping_12": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Delivery Delays",
                "answer": "<p>Delivery dates are estimates unless expressly stated otherwise.</p><p>Carrier disruptions, customs processing, severe weather, transportation restrictions, labor disruptions, governmental action, dangerous-goods requirements, natural disasters, and other circumstances outside our reasonable control may affect delivery times.</p><p>Where a material delay occurs, we will communicate available options and provide cancellation or refund rights where required by applicable law.</p>"
              },
              "blocks": {}
            }
          },
