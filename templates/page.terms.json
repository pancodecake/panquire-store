          "blocks": {
            "payment_1": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What currencies do you accept?",
                "answer": "<p>Your checkout summary shows the currency for your order. The store currently lists prices in USD.</p>"
              },
              "blocks": {}
            },
            "payment_2": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What payment methods do you accept?",
                "answer": "<p>The available payment options are shown at checkout.</p>"
              },
              "blocks": {}
            },
            "payment_3": {
              "type": "pq-policy-question",
              "settings": {
                "question": "When will I be charged?",
                "answer": "<p>Payment is collected at checkout. An automated acknowledgment confirms receipt of the order. Panquire aims to confirm accepted orders within three days.</p>"
              },
              "blocks": {}
            },
            "payment_4": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Where can I see taxes and shipping charges?",
                "answer": "<p>Free outbound shipping is included in the product price for supported destinations. Review checkout for currency, taxes collected and other disclosed charges. Duties and taxes may apply separately.</p>"
              },
              "blocks": {}
            },
            "payment_5": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Who pays tariffs, customs duties, and import charges?",
                "answer": "<p>If checkout says duties and taxes are included, Panquire arranges the specified payments. When excluded, customs or carrier charges may be payable by the customer. See the <a href=\"/policies/shipping-policy\">Shipping Policy</a>.</p>"
              },
              "blocks": {}
            },
            "payment_6": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Can I cancel a preorder?",
                "answer": "<p>Preorder dates and any special conditions are disclosed before purchase. Preorder payments and deposits are refundable on cancellation before dispatch. See the <a href=\"/policies/refund-policy\">Return and Refund Policy</a>.</p>"
              },
              "blocks": {}
            }
          },
