          },
          "blocks": {
            "payment_1": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What currencies do you display and charge?",
                "answer": "<p>Prices and payments are available in <strong>U.S. Dollars (USD)</strong> and <strong>Euros (EUR)</strong>. The applicable transaction currency will be displayed at checkout before you confirm your order.</p>"
              },
              "blocks": {}
            },
            "payment_2": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What payment methods do you accept?",
                "answer": "<p>We accept direct payment through the payment methods made available at checkout. Available payment options will be displayed before you complete your purchase.</p>"
              },
              "blocks": {}
            },
            "payment_3": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Do you offer financing or installment payments?",
                "answer": "<p>No. We currently do not offer financing or installment-payment plans.</p><p>Unless otherwise stated for a pre-order or deposit, payment is due in full according to the terms displayed at checkout.</p>"
              },
              "blocks": {}
            },
            "payment_4": {
              "type": "pq-policy-question",
              "settings": {
                "question": "When will I be charged?",
                "answer": "<p>Payment details are submitted at checkout. Your payment is processed when we accept your order.</p><p>Submitting an order does not automatically mean that the order has been accepted. We reserve the right to review an order before accepting it.</p><p>If an order cannot be accepted after payment has already been processed, the applicable amount will be refunded to the original payment method.</p>"
              },
              "blocks": {}
            },
            "payment_5": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Do you accept deposits or pre-orders?",
                "answer": "<p>Yes. Selected products may be offered for pre-order or reservation with a deposit.</p><p>The applicable deposit amount, estimated availability, remaining balance requirements, and any product-specific pre-order conditions will be displayed before purchase.</p><p>Estimated shipping or availability dates are estimates and may change due to production, transportation, customs, regulatory, or other circumstances outside our reasonable control.</p><p>If a significant delay occurs, we will provide the customer with the available options, which may include continuing with the order, transferring the deposit, or requesting a refund where applicable.</p>"
              },
              "blocks": {}
            },
            "payment_6": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Are deposits refundable or transferable?",
                "answer": "<p>Unless otherwise clearly stated before purchase, deposits and eligible pre-order payments are <strong>refundable</strong> and may also be transferred to another eligible product or order with our approval.</p><p>Product-specific pre-order conditions may apply and will be disclosed before payment.</p>"
              },
              "blocks": {}
            },
            "payment_7": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Are sales tax or VAT added after checkout?",
                "answer": "<p>The total amount displayed at checkout is intended to represent the final amount payable by the customer.</p><p>Where applicable, sales tax or VAT is included in the displayed price or checkout total or otherwise borne by us.</p><p>We will not add undisclosed taxes after the customer completes the order.</p>"
              },
              "blocks": {}
            },
            "payment_8": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Who pays tariffs, customs duties, and import charges?",
                "answer": "<p>We bear applicable tariffs, customs duties, import charges, and other seller-arranged international import costs for shipments covered by our shipping policy.</p><p>Customers will not normally be required to pay additional import charges unless an exception has been clearly disclosed before purchase or the charge results from circumstances outside the agreed delivery arrangement.</p>"
              },
              "blocks": {}
            },
            "payment_9": {
              "type": "pq-policy-question",
              "settings": {
                "question": "How are shipping costs calculated?",
                "answer": "<p>Any applicable shipping charge will be displayed at checkout before payment is submitted.</p><p>You will be able to review the total purchase amount before completing the order.</p>"
              },
              "blocks": {}
            },
            "payment_10": {
              "type": "pq-policy-question",
              "settings": {
                "question": "How long do refunds take?",
                "answer": "<p>Once a cancellation, return, or refund has been approved, we will initiate the refund to the original payment method within <strong>1–3 business days</strong>.</p><p>Additional processing time may be required by your bank, card issuer, or payment provider after the refund has been issued by us.</p>"
              },
              "blocks": {}
            }
          },
