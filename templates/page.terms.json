        "returns_refunds": {
          "type": "pq-policy-category",
          "settings": {
            "heading": "Returns and Refunds",
            "anchor": "returns-refunds"
          },
          "blocks": {
            "returns_refunds_1": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What is the voluntary return period?",
                "answer": "<p>For eligible change-of-mind returns, contact Panquire within seven days after delivery. The product should be unused, undamaged and in its original condition with its packaging and included items. Opening the packaging for reasonable inspection does not automatically disqualify the return.</p>"
              },
              "blocks": {}
            },
            "returns_refunds_2": {
              "type": "pq-policy-question",
              "settings": {
                "question": "How do I request a return?",
                "answer": "<p>Email <a href=\"mailto:support@panquire.com\">support@panquire.com</a> or use the <a href=\"/pages/contact\">contact form</a>. Include your order number and the reason for the return. For a voluntary return, obtain authorization and safe shipping instructions before sending the item.</p>"
              },
              "blocks": {}
            },
            "returns_refunds_3": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Who pays return shipping?",
                "answer": "<p>For eligible change-of-mind returns, the customer pays the direct return shipping cost charged by the carrier and service they choose, subject to applicable law and shipping requirements. Panquire covers authorized return shipping for approved quality-related returns and items damaged or sent incorrectly due to its error.</p>"
              },
              "blocks": {}
            },
            "returns_refunds_4": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Do you charge restocking fees?",
                "answer": "<p>Panquire does not charge restocking, inspection, repackaging or administrative fees for approved returns under its standard policy.</p>"
              },
              "blocks": {}
            },
            "returns_refunds_5": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What if my product is defective, damaged or incorrect?",
                "answer": "<p>Contact Panquire promptly with your order number and a description of the issue. The policy asks customers to report initial quality issues within three days of receipt. Warranty and statutory rights still apply to problems discovered later.</p>"
              },
              "blocks": {}
            },
            "returns_refunds_6": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Can I cancel before dispatch?",
                "answer": "<p>Contact Panquire to request cancellation. If cancellation is completed before dispatch, Panquire issues a full refund without administrative or restocking fees. After dispatch, applicable return procedures and statutory rights apply.</p>"
              },
              "blocks": {}
            },
            "returns_refunds_7": {
              "type": "pq-policy-question",
              "settings": {
                "question": "When will my refund be issued?",
                "answer": "<p>Approved refunds are normally initiated to the original payment method within one to three business days after verification or final approval. Your payment provider may take additional time to post the refund. Statutory deadlines take precedence.</p>"
              },
              "blocks": {}
            },
            "returns_refunds_8": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What withdrawal rights apply in the EU and UK?",
                "answer": "<p>Eligible customers generally have 14 days after receipt to give notice of withdrawal and a further 14 days to return the goods, subject to legal exceptions. Email <a href=\"mailto:support@panquire.com\">support@panquire.com</a> or use the available withdrawal function. See the <a href=\"/policies/refund-policy\">Return and Refund Policy</a> for the full process.</p>"
              },
              "blocks": {}
            },
            "returns_refunds_9": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What should I do with an unsafe battery?",
                "answer": "<p>Contact Panquire for safe handling and collection instructions. Do not send damaged or otherwise unsafe batteries by ordinary parcel service.</p>"
              },
              "blocks": {}
            },
            "returns_refunds_10": {
              "type": "pq-policy-question",
              "settings": {
                "question": "How do exchanges work?",
                "answer": "<p>For a voluntary exchange, request authorization for the original return and place a new order for the desired product. For defective or incorrect items, Panquire reviews the applicable remedy. See the <a href=\"/policies/refund-policy\">Return and Refund Policy</a>.</p>"
              },
              "blocks": {}
            },
            "pq_policy_question_xXY8a4": {
              "type": "pq-policy-question",
              "name": "Policy question",
              "settings": {
                "question": "Your question",
                "answer": "<p>If the return is caused by the consumer, consumer<br/>should be responsible for the shipping fee. The specific fee should be based on<br/>the express company you choose.</p><p>If due to our reasons, the goods received are<br/>damaged or not correct, and the consumer is not required to bear the shipping<br/>fee for this reason.</p>"
              },
              "blocks": {}
            }
          },
