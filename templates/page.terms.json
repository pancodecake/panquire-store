        "shipping": {
          "type": "pq-policy-category",
          "settings": {
            "heading": "Shipping",
            "anchor": "shipping"
          },
          "blocks": {
            "shipping_1": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Where do you currently ship?",
                "answer": "<p>We currently ship to eligible addresses on the <strong>U.S. West Coast</strong> and to selected European markets, including <strong>Germany and Poland</strong>.</p><p>Destination availability will be confirmed at checkout.</p><p>Certain remote areas or destinations that cannot be served safely or legally may not be available for delivery.</p>"
              },
              "blocks": {}
            },
            "shipping_2": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Which carriers do you use?",
                "answer": "<p>We primarily use <strong>FedEx</strong>.</p><p>Depending on the size, weight, destination, battery classification, and transportation requirements of the order, shipments may be handled through parcel, express, freight, or other appropriate logistics services.</p>"
              },
              "blocks": {}
            },
            "shipping_3": {
              "type": "pq-policy-question",
              "settings": {
                "question": "How are complete electric dirt bikes shipped?",
                "answer": "<p>Complete electric off-road motorcycles may be shipped by <strong>express service or freight</strong>, depending on the model, destination, shipment size, and applicable transportation requirements.</p><p>Tracking information will be provided after dispatch when available.</p>"
              },
              "blocks": {}
            },
            "shipping_4": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Are lithium-ion batteries subject to special shipping requirements?",
                "answer": "<p>Yes.</p><p>Lithium-ion batteries are subject to additional dangerous-goods transportation requirements.</p><p>Battery shipments are prepared and handled in accordance with applicable transportation regulations for the destination and shipping method.</p><p>Where required, applicable battery transportation documentation, including the relevant <strong>UN 38.3 test summary</strong>, will be maintained or made available for the battery design.</p>"
              },
              "blocks": {}
            },
            "shipping_5": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Will I receive tracking information?",
                "answer": "<p>Yes.</p><p>Once your order has been dispatched and tracking becomes available, we will provide a shipping confirmation containing the applicable tracking information.</p><p>Freight shipments may use a different tracking system from standard parcel shipments.</p>"
              },
              "blocks": {}
            },
            "shipping_6": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What should I do if my order is delayed, lost, or marked as delivered but I did not receive it?",
                "answer": "<p>Contact our customer-support team as soon as possible and provide your order number and available tracking information.</p><p>We will review the shipment and, where appropriate, coordinate a claim or investigation with the carrier or shipping insurer.</p><p>You may be asked to provide additional information or cooperate with the carrier's investigation.</p><p>If the shipment is confirmed lost, we will provide an appropriate replacement, refund, or other resolution in accordance with this policy and applicable law.</p>"
              },
              "blocks": {}
            },
            "shipping_7": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What should I do if my bike arrives damaged?",
                "answer": "<p>If your shipment arrives with visible damage:</p><ul><li>Do not discard the shipping carton, pallet, protective materials, shipping labels, or included documentation.</li><li>Take clear photographs and/or video of the outer packaging before fully unpacking the product.</li><li>Photograph the shipping label, complete vehicle, battery, packaging, and all visible damaged areas.</li><li>Where possible, note visible damage with the carrier at the time of delivery.</li><li>Do not operate or charge a visibly damaged vehicle or battery.</li><li>Contact our customer-support team as soon as possible.</li></ul><p>After reviewing the claim, we may provide replacement parts, repair assistance, arrange a return, replace the product, or provide another appropriate remedy.</p>"
              },
              "blocks": {}
            },
            "shipping_8": {
              "type": "pq-policy-question",
              "settings": {
                "question": "How quickly should shipping damage be reported?",
                "answer": "<p>Please report visible shipping damage within <strong>3 calendar days of delivery whenever reasonably possible</strong>.</p><p>Early reporting allows us to document the condition of the shipment and pursue the carrier or shipping-insurance claim more effectively.</p><p>Failure to report visible damage within this requested period does not limit any consumer, warranty, or statutory rights that cannot legally be excluded.</p>"
              },
              "blocks": {}
            },
            "shipping_9": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What evidence is required for a shipping-damage claim?",
                "answer": "<p>We may request:</p><ul><li>Order number</li><li>Tracking information</li><li>Shipping label photographs</li><li>Photographs or video of the outer packaging</li><li>Photographs of the complete product</li><li>Close-up photographs or video of damaged areas</li><li>Battery photographs where relevant</li><li>Additional documentation reasonably required to verify the claim</li></ul><p>Please retain the original packaging until your claim has been resolved.</p>"
              },
              "blocks": {}
            },
            "shipping_10": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Who pays return shipping?",
                "answer": "<p>For an eligible <strong>change-of-mind or non-quality return</strong>, the customer is responsible for return shipping unless otherwise required by applicable law.</p><p>For a <strong>confirmed defective product</strong>, we are responsible for the applicable return-shipping costs.</p><p>If we send the <strong>wrong product</strong>, we are responsible for return shipping.</p><p>For <strong>confirmed shipping damage</strong>, we are responsible for the applicable return-shipping costs.</p>"
              },
              "blocks": {}
            },
            "shipping_11": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What certifications or trust badges may appear on the website?",
                "answer": "<p>We display certifications, safety claims, and compliance marks only where we hold the applicable documentation for the relevant product or component.</p><p>Depending on the product, these may include documentation related to:</p><ul><li>UN 38.3 lithium-battery transportation testing</li><li>Applicable CE or EU conformity documentation</li><li>Applicable UL certification or testing</li><li>Manufacturer or authorized-seller status</li><li>Product warranty coverage</li><li>Duties and import-fee arrangements</li><li>Verified</li></ul>"
              },
              "blocks": {}
            }
          },
