        "warranty": {
          "type": "pq-policy-category",
          "settings": {
            "heading": "Warranty",
            "anchor": "warranty"
          },
          "blocks": {
            "warranty_1": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Two-Year Limited Commercial Warranty",
                "answer": "<p>[Store Name] provides a <strong>two-year limited commercial warranty</strong> on the covered components described below.</p><p>This commercial warranty is provided in addition to, and does not replace or reduce, any statutory consumer rights or legal guarantees that cannot legally be excluded.</p>"
              },
              "blocks": {}
            },
            "warranty_2": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What is covered?",
                "answer": "<p>Subject to the conditions and exclusions below, the following components are covered for <strong>2 years</strong>:</p><ul><li>Complete vehicle</li><li>Battery</li><li>Motor</li><li>Controller</li><li>Charger</li><li>Frame</li><li>Covered electronic components</li></ul>"
              },
              "blocks": {}
            },
            "warranty_3": {
              "type": "pq-policy-question",
              "settings": {
                "question": "When does the warranty begin?",
                "answer": "<p>The warranty period begins on the date the product is delivered to the original purchaser.</p>"
              },
              "blocks": {}
            },
            "warranty_4": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Is proof of purchase required?",
                "answer": "<p>Yes.</p><p>Proof of purchase is required for a warranty claim.</p><p>We may also use your order number, purchase email address, and product serial number to verify warranty eligibility.</p>"
              },
              "blocks": {}
            },
            "warranty_5": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Is the warranty transferable?",
                "answer": "<p>No.</p><p>The commercial warranty applies to the original purchaser and is not transferable to a subsequent owner, except where applicable law requires otherwise.</p>"
              },
              "blocks": {}
            },
            "warranty_6": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What happens when a warranty claim is approved?",
                "answer": "<p>For an approved warranty claim, [Store Name] will provide the required covered replacement part at no charge.</p><p>Approved warranty replacement parts supplied under this policy will be <strong>new parts</strong>.</p><p>Where applicable, we will also cover reasonable shipping costs associated with an approved defective-product warranty remedy.</p>"
              },
              "blocks": {}
            },
            "warranty_7": {
              "type": "pq-policy-question",
              "settings": {
                "question": "How do I submit a warranty claim?",
                "answer": "<p>Warranty claims must first be submitted through <strong>[warranty/support form URL]</strong>.</p><p>Please include your order information and a clear description of the problem.</p><p>Depending on the issue, our support team may schedule a telephone or video diagnostic session before approving replacement parts, repair, return service, or another remedy.</p>"
              },
              "blocks": {}
            },
            "warranty_8": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What information may be required?",
                "answer": "<p>Depending on the claim, we may reasonably request:</p><ul><li>proof of purchase;</li><li>order number;</li><li>product serial number;</li><li>photographs;</li><li>video showing the issue;</li><li>error codes;</li><li>mileage or usage information;</li><li>diagnostic information;</li><li>or other information reasonably necessary to identify the problem.</li></ul>"
              },
              "blocks": {}
            },
            "warranty_9": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Do I need authorization before returning a product?",
                "answer": "<p>Yes.</p><p>All warranty returns, warranty repairs, and warranty replacements require prior authorization from [Store Name].</p><p>Do not return a vehicle, battery, component, or other product unless you have received written return instructions.</p>"
              },
              "blocks": {}
            },
            "warranty_10": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Who performs warranty repairs?",
                "answer": "<p>Warranty repairs must be performed by an authorized service center or another service provider specifically authorized by [Store Name].</p><p>Customers should not perform repairs requiring professional service unless the procedure has been expressly authorized by us.</p>"
              },
              "blocks": {}
            },
            "warranty_11": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What is not covered by the commercial warranty?",
                "answer": "<p>The commercial warranty does not cover damage or failure caused by:</p><ul><li>accident, collision, or impact;</li><li>competition or racing use;</li><li>misuse or abuse;</li><li>operation outside the product's intended conditions;</li><li>water or moisture exposure beyond the product's stated protection or intended use;</li><li>unauthorized modification or performance alteration;</li><li>unauthorized firmware or controller modification;</li><li>improper assembly;</li><li>improper maintenance;</li><li>normal wear and deterioration;</li><li>incompatible batteries;</li><li>incompatible chargers;</li><li>or incompatible electrical or mechanical components.</li></ul><p>Where required by applicable law, a claim will not be denied solely because a modification or third-party component exists if that condition is unrelated to the claimed failure.</p>"
              },
              "blocks": {}
            },
            "warranty_12": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What parts are considered normal wear items?",
                "answer": "<p>Normal wear items include, without limitation:</p><ul><li>tires;</li><li>brake pads;</li><li>and the drive chain.</li></ul><p>Normal deterioration caused by ordinary use is not covered by the commercial warranty.</p><p>A wear item may still qualify for a remedy where the problem results from a manufacturing defect rather than ordinary wear, subject to applicable law.</p>"
              },
              "blocks": {}
            },
            "warranty_13": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Is battery-capacity decline covered?",
                "answer": "<p>The battery warranty covers manufacturing defects and <strong>abnormal capacity deterioration</strong> during the applicable warranty period.</p><p>Gradual battery-capacity or riding-range reduction resulting from normal aging, charge cycles, temperature, storage conditions, rider weight, terrain, riding style, or normal use is not considered a manufacturing defect.</p><p>For battery-capacity claims, diagnostic testing may be required to determine whether the degradation is abnormal and covered by warranty.</p>"
              },
              "blocks": {}
            },
            "warranty_14": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Are software and firmware issues covered?",
                "answer": "<p>Yes.</p><p>Defects in factory-supplied software or firmware that materially affect the normal operation of a covered product are eligible for support during the warranty period.</p><p>A resolution may include:</p><ul><li>diagnostics;</li><li>configuration changes;</li><li>software updates;</li><li>firmware updates;</li><li>component repair;</li><li>or component replacement.</li></ul><p>Damage caused by unauthorized firmware, controller programming, or bypassing safety systems is not covered by the commercial warranty.</p>"
              },
              "blocks": {}
            },
            "warranty_15": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Does a replaced component receive a new warranty?",
                "answer": "<p>Yes.</p><p>A replacement component supplied under an approved warranty claim receives a new <strong>two-year commercial warranty</strong> beginning on the date the replacement component is delivered or installed, as applicable.</p><p>The renewed warranty applies only to the replaced component and does not restart the warranty period for unrelated parts of the motorcycle.</p>"
              },
              "blocks": {}
            },
            "warranty_16": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What happens if the product cannot be repaired?",
                "answer": "<p>If an approved defect cannot reasonably be repaired, we will explain the reason and provide an appropriate alternative remedy.</p><p>Depending on the circumstances, this may include:</p><ul><li>replacement of the affected component;</li><li>replacement of the product;</li><li>price adjustment;</li><li>refund;</li><li>or another remedy required by applicable law.</li></ul>"
              },
              "blocks": {}
            },
            "warranty_17": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Product Use & Safety",
                "answer": "<p>Certain products sold by [Store Name] may be designed primarily or exclusively for <strong>off-road use</strong> and may not be licensed, registered, approved, or legal for use on public roads, bicycle paths, sidewalks, or other public areas in every jurisdiction.</p><p>Unless we expressly state that a specific model is approved for a particular form of public-road use in the customer's jurisdiction, no such representation is made.</p><p>Customers and riders are responsible for understanding and complying with applicable:</p><ul><li>operating laws;</li><li>registration requirements;</li><li>licensing requirements;</li><li>age restrictions;</li><li>helmet requirements;</li><li>insurance requirements;</li><li>equipment requirements;</li><li>and land-access rules.</li></ul><p>Electric dirt bikes and other powered two-wheel vehicles involve inherent risks.</p><p>Loss of control, collisions, terrain, speed, improper operation, insufficient protective equipment, or mechanical failure may result in property damage, serious injury, or death.</p><p>Riders should operate the product only within their abilities and the manufacturer's intended conditions, wear suitable protective equipment, inspect the vehicle before riding, and follow the owner's manual and safety instructions.</p>"
              },
              "blocks": {}
            },
            "warranty_18": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Assembly & Pre-Ride Inspection",
                "answer": "<p>Some products may require final assembly, adjustment, or inspection after delivery.</p><p>Before riding, customers must follow the applicable assembly instructions and confirm that safety-critical components are correctly installed and functioning.</p><p>This includes, where applicable:</p><ul><li>brakes;</li><li>wheels;</li><li>steering;</li><li>controls;</li><li>drivetrain;</li><li>fasteners;</li><li>battery connections;</li><li>and other components specified in the owner's manual.</li></ul><p>Where professional assembly or inspection is recommended, we strongly recommend using a qualified technician.</p><p>Damage directly caused by improper assembly is not covered by the commercial warranty to the extent permitted by applicable law.</p>"
              },
              "blocks": {}
            },
            "warranty_19": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Lithium-Ion Battery Safety",
                "answer": "<p>Only use the charger supplied with the product or a charger specifically approved by the manufacturer for that battery.</p><p>Follow all manufacturer charging and storage instructions.</p><p>Do not charge or use a battery or charger that appears:</p><ul><li>damaged;</li><li>swollen;</li><li>punctured;</li><li>overheated;</li><li>wet;</li><li>leaking;</li><li>modified;</li><li>or otherwise unsafe.</li></ul><p>Do not use an incompatible or so-called universal charger unless it has been specifically approved for your battery and vehicle.</p><p>Do not dismantle, crush, puncture, burn, or improperly dispose of lithium-ion batteries.</p><p>Contact [Store Name] for instructions if you believe a battery is defective or unsafe.</p>"
              },
              "blocks": {}
            }
          },
