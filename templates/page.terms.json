        "payment": {
          "type": "pq-policy-category",
          "settings": {
            "heading": "Payment",
            "anchor": "payment"
          },
          "blocks": {
            "payment_1": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What currencies do you accept?",
                "answer": "<p>Prices and payments are available in <strong>U.S. Dollars (USD)</strong> and <strong>Euros (EUR)</strong>. The applicable transaction currency will be clearly displayed at checkout before the order is submitted.</p>"
              },
              "blocks": {}
            },
            "payment_2": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What payment methods do you accept?",
                "answer": "<p>We accept direct payment through the payment methods available at our Shopify checkout. Available payment options will be displayed before you complete your order.</p><p>We currently do not offer financing or installment-payment plans.</p>"
              },
              "blocks": {}
            },
            "payment_3": {
              "type": "pq-policy-question",
              "settings": {
                "question": "When will I be charged?",
                "answer": "<p>Payment information is submitted at checkout. Payment will be processed when we accept your order.</p><p>Submitting an order does not automatically constitute acceptance of that order. We reserve the right to review an order before accepting or fulfilling it.</p><p>If we are unable to accept an order after payment has already been processed, the applicable amount will be refunded to the original payment method.</p>"
              },
              "blocks": {}
            },
            "payment_4": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Do you accept pre-orders or deposits?",
                "answer": "<p>Yes. Selected products may be offered for pre-order or reservation with a deposit.</p><p>The applicable deposit amount, estimated availability date, remaining balance requirements, and any product-specific pre-order conditions will be shown before purchase.</p><p>Unless otherwise clearly disclosed before purchase, eligible deposits and pre-order payments are refundable.</p><p>With our approval, a deposit may also be transferred to another eligible product or order.</p>"
              },
              "blocks": {}
            },
            "payment_5": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Are taxes included in the displayed price?",
                "answer": "<p>The total price shown at checkout is intended to represent the final amount payable by the customer.</p><p>Where applicable, sales tax or VAT will be included in the displayed or checkout total or otherwise borne by [Store Name].</p><p>We will not add undisclosed taxes to an order after checkout has been completed.</p>"
              },
              "blocks": {}
            },
            "payment_6": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Who pays tariffs, customs duties, and import charges?",
                "answer": "<p>For shipments covered by this policy, <strong>[Store Name] bears applicable tariffs, customs duties, import charges, and seller-arranged international import costs</strong>.</p><p>Customers should not be required to pay additional import charges unless an exception was clearly disclosed before purchase or the charge results from circumstances outside the agreed delivery arrangement.</p>"
              },
              "blocks": {}
            },
            "payment_7": {
              "type": "pq-policy-question",
              "settings": {
                "question": "How are shipping charges calculated?",
                "answer": "<p>Any applicable shipping charge will be displayed at checkout before payment is submitted.</p><p>You will be able to review the total order amount before completing your purchase.</p>"
              },
              "blocks": {}
            },
            "payment_8": {
              "type": "pq-policy-question",
              "settings": {
                "question": "How long do refunds take?",
                "answer": "<p>Once a cancellation, return, or refund has been approved, we will initiate the refund to the original payment method within <strong>1–3 business days</strong>.</p><p>Additional processing time may be required by your bank, card issuer, or payment provider after the refund has been issued by us.</p>"
              },
              "blocks": {}
            },
            "payment_9": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Orders & Product Information",
                "answer": "<p>Submitting an order constitutes an offer to purchase and does not guarantee order acceptance.</p><p>We may decline or cancel an order where reasonably necessary, including in cases involving:</p><ul><li>suspected fraud;</li><li>payment problems;</li><li>pricing errors;</li><li>inventory errors;</li><li>shipping restrictions;</li><li>inaccurate customer information;</li><li>unusual quantities;</li><li>suspected unauthorized resale;</li><li>or inability to lawfully deliver the product.</li></ul><p>If we cancel an order after payment has been collected, the applicable amount will be refunded.</p><p>We make reasonable efforts to present product descriptions, specifications, photographs, availability, and pricing accurately.</p><p>Photography and display settings may cause minor differences in product appearance.</p><p>Manufacturers may make production updates or improvements to specifications where legally permitted, provided the delivered product remains consistent with the applicable purchase agreement and mandatory consumer rights.</p>"
              },
              "blocks": {}
            }
          },
