            "returns_refunds_8": {
              "type": "pq-policy-question",
              "settings": {
                "question": "How do I request a return?",
                "answer": "<p>Before returning any product, submit a return request through <strong>[return/warranty URL]</strong>.</p><p>Please include:</p><ul><li>your order number;</li><li>the reason for the return;</li><li>and any requested photographs or video.</li></ul><p>Do not ship the product until you receive written return authorization and shipping instructions from [Store Name].</p><p>Once the return is approved, we will provide the applicable return address and instructions.</p><p>The product must be shipped within the period specified in the authorization.</p>"
