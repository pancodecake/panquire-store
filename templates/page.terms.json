        "returns_refunds": {
          "type": "pq-policy-category",
          "settings": {
            "heading": "Returns and Refunds",
            "anchor": "returns-refunds"
          },
          "blocks": {
            "returns_refunds_1": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What is the return period?",
                "answer": "<p>For eligible <strong>U.S. voluntary or change-of-mind returns</strong>, products may be returned within <strong>7 calendar days after delivery</strong>, subject to the conditions below.</p><p>For eligible <strong>EU consumer orders, including Germany and Poland</strong>, the applicable statutory withdrawal period will apply, which is generally <strong>14 days from delivery</strong>, subject to lawful exceptions.</p><p>Defective, incorrect, or transit-damaged products are handled separately under our warranty, damaged-product, and statutory consumer-rights procedures and are not limited solely to the voluntary return period.</p>"
              },
              "blocks": {}
            },
            "returns_refunds_2": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What should I do if the product arrives defective?",
                "answer": "<p>Visible transit damage, missing components, or a product that appears defective immediately upon delivery should be reported within <strong>3 calendar days whenever reasonably possible</strong>.</p><p>This allows us to document the issue and provide faster support.</p><p>Defects reported after this period will still be reviewed under the applicable commercial warranty and any statutory consumer rights.</p>"
              },
              "blocks": {}
            },
            "returns_refunds_3": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What condition must a non-defective return be in?",
                "answer": "<p>For a voluntary non-defective return, the product must be returned in substantially the same condition in which it was received and should include:</p><ul><li>original packaging;</li><li>charger;</li><li>keys;</li><li>manuals;</li><li>accessories;</li><li>hardware;</li><li>and other originally included items.</li></ul><p>Customers should retain the original shipping packaging during the applicable return period.</p>"
              },
              "blocks": {}
            },
            "returns_refunds_4": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Do you charge restocking fees?",
                "answer": "<p>No.</p><p>[Store Name] does not charge a standard:</p><ul><li>restocking fee;</li><li>inspection fee;</li><li>or repackaging fee</li></ul><p>for an otherwise eligible return.</p><p>However, where permitted by applicable law, we may account for material damage, missing components, or loss in value caused by handling beyond what is reasonably necessary to inspect the product.</p>"
              },
              "blocks": {}
            },
            "returns_refunds_5": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Who pays return shipping?",
                "answer": "<p>For eligible <strong>change-of-mind or non-quality returns</strong>, the customer is responsible for return shipping.</p><p>[Store Name] pays applicable return shipping for:</p><ul><li>confirmed defective products;</li><li>incorrect products sent by us;</li><li>and confirmed transit-damaged products.</li></ul>"
              },
              "blocks": {}
            },
            "returns_refunds_6": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Are deposits and pre-orders refundable?",
                "answer": "<p>Yes.</p><p>Eligible deposits and pre-order payments are refundable in accordance with the applicable pre-order conditions.</p><p>Where permitted, customers may also request that an eligible deposit be transferred to another product or order with our approval.</p>"
              },
              "blocks": {}
            },
            "returns_refunds_7": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Are custom, modified, clearance, final-sale, or used products returnable?",
                "answer": "<p>Custom, modified, clearance, final-sale, or used products are generally not eligible for voluntary non-quality returns unless otherwise stated.</p><p>This restriction does not eliminate remedies for eligible defective, incorrect, or damaged products and does not limit any consumer rights that cannot legally be excluded.</p>"
              },
              "blocks": {}
