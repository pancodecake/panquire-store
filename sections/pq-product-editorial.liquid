{% liquid
  assign data = product.metafields.panquire
  assign t01_editorial = false
  if product.handle == 't-01' and request.locale.iso_code == 'en'
    assign t01_editorial = true
  endif
%}
{{ 'panquire-product-page.css' | asset_url | stylesheet_tag }}
<div class="pq pq-product-editorial" id="ProductEditorial-{{ section.id }}">
  <div class="pq-product-wrap">
    {% render 'pq-product-selection', product: product %}
    {% if t01_editorial %}
      {% render 'pq-t01-product-story' %}
    {% else %}
    {% for story in data.stories.value %}
      <section class="pq-product-story">
        <div class="pq-product-story__image">
          {% if product.handle == 't-01' and forloop.index == 1 %}
            <img src="{{ 'RiderGreen.png' | asset_url }}" width="7680" height="4320" alt="{{ product.title | escape }}" loading="lazy">
          {% elsif product.handle == 't-02' and forloop.index == 1 %}
            <img src="{{ 'RiderJump2.png' | asset_url }}" width="1920" height="1080" alt="{{ product.title | escape }}" loading="lazy">
          {% elsif product.handle == 't-01' and forloop.index == 2 %}
            <img src="{{ 'RiderHill.png' | asset_url }}" width="7680" height="4320" alt="{{ product.title | escape }}" loading="lazy">
          {% elsif product.handle == 't-02' and forloop.index == 2 %}
            <img src="{{ 'Control And Ride.png' | asset_url }}" width="7680" height="4320" alt="{{ product.title | escape }}" loading="lazy">
          {% elsif product.handle == 't-01' and forloop.index == 3 %}
            <img src="{{ 'riderJump.png' | asset_url }}" width="2334" height="2905" alt="{{ product.title | escape }}" loading="lazy">
          {% elsif product.handle == 't-02' and forloop.index == 3 %}
            <img src="{{ 'RiderDrift.png' | asset_url }}" width="1920" height="1080" alt="{{ product.title | escape }}" loading="lazy">
          {% else %}
            {% render 'pq-page-image', product: product, media_id: story.media_id, alt: product.title %}
          {% endif %}
        </div>
        <div class="pq-product-story__copy"><span class="pq-product-eyebrow">{{ product.handle | upcase | escape }} / 0{{ forloop.index }}</span><h2>{{ story.heading | escape }}</h2><p>{{ story.body | escape }}</p></div>
      </section>
    {% endfor %}
    {% endif %}
    {% if data.geometry_image.value %}
      <details class="pq-product-disclosure" open>
        <summary><h2>{{ 'panquire.product_page.geometry' | t }}</h2><span aria-hidden="true">+</span></summary>
        <div class="pq-product-geometry">
          {{ data.geometry_image.value | image_url: width: 1800 | image_tag: widths: '600,900,1200,1800', sizes: '(min-width: 990px) 65vw, 100vw', loading: 'lazy', alt: product.title }}
          <dl>{% for item in data.geometry_rows.value %}{% if item.value != blank %}<div><dt>{{ item.label | escape }}</dt><dd>{{ item.value | escape }}</dd></div>{% endif %}{% endfor %}</dl>
        </div>
      </details>
    {% endif %}
    <details class="pq-product-disclosure" open>
      <summary><h2>{{ 'panquire.product_page.specifications' | t }}</h2><span aria-hidden="true">+</span></summary>
      {% capture source %}{{ product.metafields.custom.panquire_specifications.value }}
{{ data.specification_additions.value }}{% endcapture %}
      {% assign rows = source | newline_to_br | split: '<br />' %}
      {% assign categories = 'Overview,Performance,Battery & charging,Suspension & brakes,Dimensions & weight' | split: ',' %}
      <div class="pq-product-specifications">
        {% for category in categories %}<section><h3>{{ category | escape }}</h3><dl>
          {% assign shown_labels = "|" %}
          {% for row in rows %}
            {% assign cells = row | strip | split: "|" %}
            {% assign label_token = cells[1] | prepend: "|" | append: "|" %}
            {% if cells[0] == category and cells[2] != blank %}
              {% unless shown_labels contains label_token %}
                <div><dt>{{ cells[1] | escape }}</dt><dd>{{ cells[2] | escape }}</dd></div>
                {% assign shown_labels = shown_labels | append: cells[1] | append: "|" %}
              {% endunless %}
            {% endif %}
          {% endfor %}
        </dl></section>{% endfor %}
      </div>
    </details>
    {% render 'pq-model-comparison', product: product, section_id: section.id %}
    {% if t01_editorial %}
      {% render 'pq-t01-product-faq' %}
    {% elsif data.faqs.value.size > 0 %}
      <section class="pq-product-faq"><h2>{{ 'panquire.product_page.faqs' | t }}</h2>
        {% for faq in data.faqs.value %}<details class="pq-product-disclosure"><summary><h3>{{ faq.question | escape }}</h3><span aria-hidden="true">+</span></summary><div class="pq-product-answer"><p>{% if faq.question == 'Is this product in stock?' and request.locale.iso_code == 'en' %}Check the availability shown next to the purchase button for your selected configuration. See the <a href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}">Shipping Policy</a> for dispatch and delivery details.{% else %}{{ faq.answer | escape }}{% endif %}</p></div></details>{% endfor %}
        <a href="{{ pages.contact.url }}">{{ 'panquire.product_page.support' | t }}</a>
      </section>
    {% endif %}

  </div>
</div>
{% schema %}
{"name":"Panquire product details","settings":[],"presets":[{"name":"Panquire product details"}]}
{% endschema %}
