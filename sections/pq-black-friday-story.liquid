{% assign campaign_now = 'now' | date: '%s' | plus: 0 %}
{% if campaign_now < 1798790400 %}
  <section class="pq-black-friday-story" aria-labelledby="BlackFridayStory-{{ section.id }}">
    <header class="pq-black-friday-story__header">
      <h2 id="BlackFridayStory-{{ section.id }}">
        <span class="pq-black-friday-story__brand">Panquire's</span>
        <span class="pq-black-friday-story__headline">Black Friday</span>
        <span class="pq-black-friday-story__subtitle">Electric Dirt Bike Sale</span>
      </h2>
      <p class="pq-black-friday-story__live"><span><span class="visually-hidden">— </span>Is Now LIVE<span class="visually-hidden"> —</span></span></p>
    </header>

    <div class="pq-black-friday-story__panels">
      <div class="pq-black-friday-story__panel pq-black-friday-story__panel--opening">
        <p>
          This is our brand Panquire's <em class="pq-black-friday-story__accent">first-ever Black Friday sale,</em>
          so we decided to <strong class="pq-black-friday-story__statement">MAKE IT COUNT.</strong>
        </p>
      </div>

      <div class="pq-black-friday-story__panel pq-black-friday-story__panel--stock">
        <p>
          We decided to dedicate a limited, discounted stock of
          <span class="pq-black-friday-story__allocation">
            <strong>250</strong>
            <span><strong>e-dirt bikes</strong><br>per model</span>
          </span>
          to actual <strong class="pq-black-friday-story__accent">RIDERS.</strong>
        </p>
      </div>

      <div class="pq-black-friday-story__panel pq-black-friday-story__panel--discount">
        <p>
          We calculated the maximum discount we could afford while managing to
          <em class="pq-black-friday-story__accent">break even,</em> and this was the raw number:
        </p>
        <div class="pq-black-friday-story__rate-frame">
          <p class="pq-black-friday-story__rate"><strong>32%</strong></p>
        </div>
      </div>

      <div class="pq-black-friday-story__panel pq-black-friday-story__panel--deadline">
        <p>
          And the discount <strong class="pq-black-friday-story__statement">WON'T END</strong>
          until the whole dedicated stock is <strong class="pq-black-friday-story__statement">FINISHED.</strong>
        </p>
      </div>

      <div class="pq-black-friday-story__panel pq-black-friday-story__panel--riders">
        <p>So, we hope that this discount will give teen and adult riders a chance to take their first electric dirt bike for an off-road spin.</p>
      </div>

      <div class="pq-black-friday-story__panel pq-black-friday-story__panel--comparison">
        <p>
          Our electric dirt bikes might not have the branding of Sur-Ron or the price of Qronge, but we prefer to stay right in the middle,
          <em class="pq-black-friday-story__accent">just within your reach.</em>
        </p>
      </div>

      <div class="pq-black-friday-story__panel pq-black-friday-story__panel--closing">
        <span class="pq-black-friday-story__closing-rule" aria-hidden="true"><span></span></span>
        <p>
          <em class="pq-black-friday-story__accent">Happy Black Friday, everyone!</em>
          We hope that our bikes can ride with you soon.
        </p>
      </div>
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .pq-black-friday-story {
    --pq-story-gold: #c99850;
    --pq-story-edge: #816136;
    --pq-story-dark: #0c0d0f;
    --pq-story-charcoal: #17181b;
    --pq-story-width: var(--pq-content-width, calc(100% - 2rem));
    --pq-story-body: var(--pq-body-font, var(--font-body--family, Arial, sans-serif));
    --pq-story-display: var(--pq-heading-font, var(--font-heading--family, Arial, sans-serif));
    padding-block: clamp(2.5rem, 6vw, 5rem);
    background: linear-gradient(180deg, var(--color-bg-page, #0b0b0d), #080809 22%, #080809 78%, var(--color-bg-page, #0b0b0d));
    color: #f5f2eb;
    font: 400 clamp(1.0625rem, 1.65vw, 1.55rem)/1.42 var(--pq-story-body);
    text-align: center;
  }

  .pq-black-friday-story :is(h2, p) {
    margin: 0;
    color: inherit;
  }

  .pq-black-friday-story__header {
    box-sizing: border-box;
    width: calc(var(--pq-story-width) * .78);
    margin: 0 auto;
    padding: clamp(1.65rem, 3.6vw, 3.5rem) clamp(1rem, 4vw, 4rem);
    border: 1px solid var(--pq-story-edge);
    background: radial-gradient(ellipse at 50% 0%, #151619, var(--pq-story-dark) 74%);
  }

  .pq-black-friday-story .pq-black-friday-story__header h2 {
    display: grid;
    gap: .2em;
    font: 700 clamp(1.5rem, 3.4vw, 3rem)/1.12 var(--pq-story-display);
    color: inherit;
    text-wrap: balance;
  }

  .pq-black-friday-story .pq-black-friday-story__header h2 > span { color: inherit; }

  .pq-black-friday-story .pq-black-friday-story__header h2 > .pq-black-friday-story__brand,
  .pq-black-friday-story__accent { color: var(--pq-story-gold); }

  .pq-black-friday-story__brand {
    font-size: .9em;
    font-style: italic;
    font-weight: 400;
  }

  .pq-black-friday-story__headline,
  .pq-black-friday-story__statement,
  .pq-black-friday-story__allocation strong,
  .pq-black-friday-story__rate strong {
    font-family: var(--pq-story-display);
    font-weight: 900;
    line-height: 1.04;
    letter-spacing: -.035em;
  }

  .pq-black-friday-story__headline {
    font-size: clamp(2.2rem, 6vw, 5rem);
    text-transform: uppercase;
  }

  .pq-black-friday-story .pq-black-friday-story__live {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    column-gap: clamp(.55rem, 4vw, 3.5rem);
    max-width: 58rem;
    margin: clamp(1.1rem, 2.3vw, 2rem) auto 0;
    color: var(--pq-story-gold);
    font: 600 clamp(.8rem, 1.6vw, 1.4rem)/1.4 var(--pq-story-display);
    letter-spacing: .17em;
    text-transform: uppercase;
  }

  .pq-black-friday-story__live::before,
  .pq-black-friday-story__live::after {
    content: "";
    height: 1px;
    background: var(--pq-story-edge);
  }

  .pq-black-friday-story__panels {
    display: grid;
    grid-template-columns: minmax(0, 1.17fr) minmax(0, 1fr);
    gap: 0;
    width: var(--pq-story-width);
    margin-inline: auto;
  }

  .pq-black-friday-story__panel {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: clamp(.65rem, 1.2vw, 1.15rem);
    padding: clamp(1.45rem, 3vw, 3rem);
    background: linear-gradient(145deg, #151619, var(--pq-story-dark) 78%);
    text-wrap: pretty;
  }

  .pq-black-friday-story__panel > p { max-width: 45ch; }

  .pq-black-friday-story__statement {
    display: block;
    margin-block: .2em;
    font-size: clamp(1.75rem, 4vw, 3.65rem);
    text-wrap: balance;
  }

  .pq-black-friday-story__panel--opening em {
    display: block;
    font-size: 1.24em;
  }

  .pq-black-friday-story__panel--opening::after,
  .pq-black-friday-story__panel--comparison::after {
    content: "";
    width: min(13rem, 56%);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--pq-story-gold), transparent);
  }

  .pq-black-friday-story__panel--stock {
    background: linear-gradient(135deg, #1b1c1f, var(--pq-story-charcoal) 58%, #121315);
  }

  .pq-black-friday-story__allocation {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: .3rem .8rem;
    margin-block: .4rem;
  }

  .pq-black-friday-story__allocation > strong {
    color: var(--pq-story-gold);
    font-size: clamp(3.5rem, 7.5vw, 7rem);
  }

  .pq-black-friday-story__allocation > span {
    padding-inline-start: .8rem;
    border-inline-start: 1px solid var(--pq-story-edge);
    text-align: start;
  }

  .pq-black-friday-story__rate-frame {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: .35rem;
    width: min(100%, 34rem);
  }

  .pq-black-friday-story__rate-frame::before,
  .pq-black-friday-story__rate-frame::after {
    content: "";
    height: .45rem;
    border-block: 1px solid var(--pq-story-edge);
  }

  .pq-black-friday-story__rate {
    position: relative;
    isolation: isolate;
    padding: .15em .58em;
    font-size: clamp(3.4rem, 8.5vw, 7.75rem);
    line-height: 1;
  }

  .pq-black-friday-story__rate strong { color: var(--pq-story-gold); }

  .pq-black-friday-story__rate::before,
  .pq-black-friday-story__rate::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    clip-path: polygon(10% 0, 90% 0, 100% 50%, 90% 100%, 10% 100%, 0 50%);
    content: "";
  }

  .pq-black-friday-story__rate::before { background: var(--pq-story-gold); }
  .pq-black-friday-story__rate::after { inset: 2px; background: var(--pq-story-dark); }

  .pq-black-friday-story__panel--deadline {
    background: linear-gradient(150deg, #c99850, #bb8a48 58%, #aa793e);
    color: #15100b;
  }

  .pq-black-friday-story__panel--riders {
    grid-column: 1 / -1;
    padding-block: clamp(.85rem, 1.5vw, 1.35rem);
    background: linear-gradient(90deg, var(--pq-story-dark), #171614 50%, var(--pq-story-dark));
  }

  .pq-black-friday-story__panel--riders p { max-width: 66ch; }

  .pq-black-friday-story__panel--comparison {
    text-align: start;
    background: linear-gradient(145deg, #151619, var(--pq-story-dark) 75%);
  }

  .pq-black-friday-story__panel--comparison p {
    padding-inline-start: 1rem;
    border-inline-start: 2px solid var(--pq-story-edge);
  }

  .pq-black-friday-story__panel--comparison em,
  .pq-black-friday-story__panel--closing em {
    display: block;
    margin-block: .15em;
    font-size: clamp(1.35rem, 3vw, 2.6rem);
    line-height: 1.25;
  }

  .pq-black-friday-story__panel--closing {
    background: linear-gradient(145deg, var(--pq-story-dark), #141517 72%, var(--pq-story-dark));
  }

  .pq-black-friday-story__closing-rule {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: .7rem;
    width: min(80%, 26rem);
    color: var(--pq-story-gold);
  }

  .pq-black-friday-story__closing-rule::before,
  .pq-black-friday-story__closing-rule::after {
    content: "";
    height: 1px;
    background: var(--pq-story-edge);
  }

  .pq-black-friday-story__closing-rule > span {
    width: .62rem;
    aspect-ratio: 1;
    transform: rotate(45deg);
    background: currentColor;
  }

  @media (max-width: 42rem) {
    .pq-black-friday-story__header { width: var(--pq-story-width); }
    .pq-black-friday-story__panels { grid-template-columns: minmax(0, 1fr); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Black Friday announcement",
  "enabled_on": { "templates": ["index"] },
  "settings": [],
  "presets": [{ "name": "Black Friday announcement" }]
}
{% endschema %}
