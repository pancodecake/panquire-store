{{ 'vs-competition.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vs-competition.js' | asset_url }}" defer></script>
{%- liquid
  assign first_product = all_products['t-01']
  assign second_product = all_products['t-02']
  assign default_product = section.settings.default_product.handle | default: 't-01'
  assign default_competitor = section.settings.default_competitor.system.handle | default: 'pro-s-17'
-%}
{% capture comparison_data %}
{
  "defaults": {"panquire": {{ default_product | json }}, "competitor": {{ default_competitor | json }}},
  "count": {{ section.settings.difference_count | json }},
  "products": [
    {% render 'comparison-record', record: first_product, kind: 'product', fallback_name: 'T-01', fallback_handle: 't-01' %},
    {% render 'comparison-record', record: second_product, kind: 'product', fallback_name: 'T-02', fallback_handle: 't-02' %}
  ],
  "competitors": [
    {% paginate shop.metaobjects.competitor_product.values by 250 %}
      {% for entry in shop.metaobjects.competitor_product.values %}
        {% render 'comparison-record', record: entry, kind: 'competitor' %}{% unless forloop.last %},{% endunless %}
      {% endfor %}
    {% endpaginate %}
  ]
}
{% endcapture %}
<pq-comparison class="pq pq-compare" style="--compare-red: {{ section.settings.competitor_color }};" data-section-id="{{ section.id }}">
  <script type="application/json" data-comparison-data>{{ comparison_data | replace: '<', '\u003c' }}</script>
  <div class="pq-container">
    <h1 class="visually-hidden">{{ page.title | default: 'Panquire vs Competition' | escape }}</h1>
    <div class="pq-compare__hero">
      {% assign sides = 'panquire,competitor' | split: ',' %}
      {% for side in sides %}
        {% if forloop.last %}<div class="pq-compare__vs" aria-hidden="true"><span>VS</span></div>{% endif %}
        <div class="pq-compare__product pq-compare__product--{{ side }}" data-product="{{ side }}">
          <div class="pq-compare__eyebrow" id="Compare-label-{{ side }}-{{ section.id }}">{% if forloop.first %}Panquire{% else %}Competition{% endif %}</div>
          <div class="pq-compare__select-wrap" data-selector="{{ side }}">
            <button class="pq-compare__select-trigger" type="button" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="Compare-label-{{ side }}-{{ section.id }} Compare-value-{{ side }}-{{ section.id }}" aria-controls="Compare-options-{{ side }}-{{ section.id }}" data-select-trigger>
              <span id="Compare-value-{{ side }}-{{ section.id }}" data-select-value>{% if forloop.first %}T-01{% else %}E Ride Pro S (17&quot;){% endif %}</span>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5"/></svg>
            </button>
            <div class="pq-compare__select-list" id="Compare-options-{{ side }}-{{ section.id }}" role="listbox" aria-labelledby="Compare-label-{{ side }}-{{ section.id }}" data-select-list></div>
          </div>
          <div class="pq-compare__media">
            <img data-image width="1000" height="700" sizes="(max-width: 700px) 90vw, 440px" alt="" hidden>
            <div class="pq-compare__placeholder" data-placeholder>
              <svg viewBox="0 0 320 180" fill="none" aria-hidden="true"><circle cx="72" cy="120" r="35"/><circle cx="250" cy="120" r="35"/><path d="M72 120 115 58 168 120H72l61-43 51 4 29-41 37 80M168 120l29-63-45-7-19 27m64-20 16-17-14-13h-25M103 55h54M61 159h200"/></svg>
              <span>PRODUCT IMAGE</span>
            </div>
          </div>
          <div class="pq-compare__pill" {% unless section.settings.show_price or section.settings.show_source %}hidden{% endunless %}>
            {% if section.settings.show_price %}<span data-price>—</span>{% endif %}
            {% if section.settings.show_source %}<a data-source target="_blank" rel="noopener noreferrer" hidden>Source<span class="visually-hidden"> (opens in a new tab)</span><span aria-hidden="true">↗</span></a>{% endif %}
          </div>
          <p class="pq-compare__availability" data-availability></p>
        </div>
      {% endfor %}
    </div>
    <section class="pq-compare__showdown" aria-labelledby="Showdown-{{ section.id }}">
      <header class="pq-compare__heading">
        <h2 id="Showdown-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        <p>{{ section.settings.supporting_text | escape }}</p>
        <div class="pq-compare__legend"><span data-legend="panquire">T-01</span><span data-legend="competitor">E Ride Pro S (17&quot;)</span></div>
      </header>
      <div class="pq-compare__analysis {% unless section.settings.show_radar %}pq-compare__analysis--table-only{% endunless %}">
        {% if section.settings.show_radar %}
          <div class="pq-compare__chart">
            <svg data-radar viewBox="0 0 440 400" role="img" aria-label="Comparison radar. Exact values are available in the specification tables."></svg>
            <div class="pq-compare__metrics" aria-label="Explore specifications" data-metrics></div>
            <p class="pq-compare__chart-note" data-chart-note></p>
          </div>
        {% endif %}
        <div class="pq-compare__differences">
          <div class="pq-compare__table-title"><h3 data-table-title>BIGGEST DIFFERENCES</h3><button type="button" data-reset hidden>Reset</button></div>
          <div class="pq-compare__table-scroll" role="region" aria-label="Comparison differences" tabindex="0"><table data-differences></table></div>
          <p class="pq-compare__margin-note">Difference = Panquire − Competition. Accent highlights follow each specification's comparison rule; qualified and non-ranked rows stay neutral.</p>
          <details class="pq-compare__full" {% if section.settings.specs_expanded %}open{% endif %}>
            <summary>View all specifications <span aria-hidden="true">↓</span></summary>
            <div class="pq-compare__table-scroll" role="region" aria-label="Complete specifications" tabindex="0"><table data-full-specs></table></div>
          </details>
        </div>
      </div>
    </section>
    <p class="visually-hidden" role="status" aria-live="polite" data-status></p>
    <noscript><p>Enable JavaScript to select models and explore their specifications.</p></noscript>
  </div>
</pq-comparison>
{% schema %}
{
  "name": "VS Competition",
  "settings": [
    {"type":"text","id":"heading","label":"Section heading","default":"SPEC SHOWDOWN"},
    {"type":"text","id":"supporting_text","label":"Supporting text","default":"Select an area to explore the differences"},
    {"type":"product","id":"default_product","label":"Default Panquire product","info":"Choose T-01 or T-02."},
    {"type":"metaobject","id":"default_competitor","label":"Default competitor","metaobject_type":"competitor_product"},
    {"type":"range","id":"difference_count","label":"Legacy differences count","info":"The fixed showdown categories now show all mutually available values; this saved setting is retained for compatibility.","min":3,"max":10,"step":1,"default":6},
    {"type":"checkbox","id":"show_radar","label":"Show radar chart","default":true},
    {"type":"checkbox","id":"show_price","label":"Show price","default":true},
    {"type":"checkbox","id":"show_source","label":"Show Source","default":true},
    {"type":"checkbox","id":"specs_expanded","label":"Start full specifications expanded","default":false},
    {"type":"color","id":"competitor_color","label":"Competition crimson","default":"#D85B59"}
  ],
  "presets": [{"name":"VS Competition"}]
}
{% endschema %}
