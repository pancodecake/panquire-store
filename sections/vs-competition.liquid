{{ 'vs-competition.css' | asset_url | stylesheet_tag }}
{{ 'pq-buying-guide.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vs-competition.js' | asset_url }}" defer></script>
{%- liquid
  assign first_product = all_products['t-01']
  assign second_product = all_products['t-02']
  assign third_product = all_products['t-03']
  assign default_product = section.settings.default_product.handle | default: 't-01'
  assign default_competitor = section.settings.default_competitor.system.handle
  assign regional_tables = page.metafields.comparison.regional_tables.value
  assign comparison_currency = 'USD'
  if regional_tables.euCountries contains localization.country.iso_code
    assign comparison_currency = 'EUR'
  endif
-%}
{% capture comparison_data %}
{
  "defaults": {"panquire": {{ default_product | json }}, "competitor": {{ default_competitor | json }}},
  "count": {{ section.settings.difference_count | json }},
  "productImages": {"t-03": {{ 'pq-showdown-t03-side.webp' | asset_url | json }}},
  {% if regional_tables != blank %}
    "regionalTables": {{ regional_tables | json }},
    "regionalCurrency": {{ comparison_currency | json }},
    "regionalCountry": {{ localization.country.iso_code | json }},
    "regionalImages": {
      {%- assign first_image = true -%}
      {%- for model in regional_tables.models -%}
        {%- for pairing in model[1] -%}
          {%- if pairing.asset != blank -%}
            {%- unless first_image -%},{%- endunless -%}
            {{ pairing.handle | json }}: {{ pairing.asset | asset_url | json }}
            {%- assign first_image = false -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    },
  {% endif %}
  "products": [
    {% render 'comparison-record', record: first_product, kind: 'product', fallback_name: 'T-01', fallback_handle: 't-01', competitors: section.settings.t01_competitors %},
    {% render 'comparison-record', record: second_product, kind: 'product', fallback_name: 'T-02', fallback_handle: 't-02', competitors: section.settings.t02_competitors %},
    {% render 'comparison-record', record: third_product, kind: 'product', fallback_name: 'T-03', fallback_handle: 't-03', competitors: section.settings.t03_competitors %}
  ],
  "competitors": [
    {% paginate shop.metaobjects.competitor_product.values by 250 %}
      {% for entry in shop.metaobjects.competitor_product.values %}
        {% render 'comparison-record', record: entry, kind: 'competitor' %}{% unless forloop.last %},{% endunless %}
      {% endfor %}
    {% endpaginate %}
  ]
}
{% endcapture %}
<pq-comparison class="pq pq-compare" style="--compare-red: {{ section.settings.competitor_color }};" data-section-id="{{ section.id }}">
  <script type="application/json" data-comparison-data>{{ comparison_data | replace: '<', '\u003c' }}</script>
  <div class="pq-container">
    <header class="pq-compare__intro">
      <h1>{{ 'panquire.storefront.panquire_vs' | t | escape_once }} <span class="pq-compare__title-accent">{{ 'panquire.storefront.competitors' | t | escape_once }}</span></h1>
      <p class="pq-long-paragraph">{{ 'panquire.storefront.considering_panquire_as_an_alternative_to_sur' | t | escape_once }}</p>
    </header>
    <section class="pq-compare__methodology" aria-labelledby="Methodology-{{ section.id }}">
      <h2 id="Methodology-{{ section.id }}">{{ 'panquire.storefront.comparison_methodology' | t | escape_once }}</h2>
      {% if regional_tables != blank %}
        <p>Prices reflect the regular U.S. or EU listings used for this comparison. Where an EU competitor price is unavailable, we show the U.S. amount in euros as a comparison reference.</p>
      {% else %}
        <p>{{ 'panquire.storefront.panquire_models_are_compared_with_similar_electric' | t | escape_once }}</p>
      {% endif %}
      <p>{{ 'panquire.storefront.we_aim_to_keep_every_comparison_accurate' | t | escape_once }} <strong>{{ 'panquire.storefront.source' | t | escape_once }}</strong> {{ 'panquire.storefront.for_the_latest_information_if_you_identify' | t | escape_once }} <a href="mailto:support@panquire.com">support@panquire.com</a>.</p>
      <p><strong>{{ 'panquire.storefront.competitor_brands_are_not_affiliated_with_or' | t | escape_once }}</strong></p>
    </section>
    <div class="pq-compare__hero">
      {% assign sides = 'panquire,competitor' | split: ',' %}
      {% for side in sides %}
        {% if forloop.last %}<div class="pq-compare__vs" aria-hidden="true"><span>VS</span></div>{% endif %}
        <div class="pq-compare__product pq-compare__product--{{ side }}" data-product="{{ side }}">
          <div class="pq-compare__eyebrow" id="Compare-label-{{ side }}-{{ section.id }}">{% if forloop.first %}Panquire{% else %}{{ 'panquire.storefront.competition' | t | escape_once }}{% endif %}</div>
          <div class="pq-compare__select-wrap" data-selector="{{ side }}">
            <button class="pq-compare__select-trigger" type="button" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="Compare-label-{{ side }}-{{ section.id }} Compare-value-{{ side }}-{{ section.id }}" aria-controls="Compare-options-{{ side }}-{{ section.id }}" data-select-trigger>
              <span id="Compare-value-{{ side }}-{{ section.id }}" data-select-value>{% if forloop.first %}T-01{% else %}E Ride Pro S (17&quot;){% endif %}</span>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5"/></svg>
            </button>
            <div class="pq-compare__select-list" id="Compare-options-{{ side }}-{{ section.id }}" role="listbox" aria-labelledby="Compare-label-{{ side }}-{{ section.id }}" data-select-list></div>
          </div>
          <div class="pq-compare__media">
            <img data-image width="1000" height="700" sizes="(max-width: 700px) 90vw, 440px" alt="" hidden>
            <div class="pq-compare__placeholder" data-placeholder>
              <svg viewBox="0 0 320 180" fill="none" aria-hidden="true"><circle cx="72" cy="120" r="35"/><circle cx="250" cy="120" r="35"/><path d="M72 120 115 58 168 120H72l61-43 51 4 29-41 37 80M168 120l29-63-45-7-19 27m64-20 16-17-14-13h-25M103 55h54M61 159h200"/></svg>
              <span>{{ 'panquire.storefront.product_image' | t | escape_once }}</span>
            </div>
          </div>
          <div class="pq-compare__pill" {% unless section.settings.show_price or section.settings.show_source %}hidden{% endunless %}>
            {% if section.settings.show_price %}<span data-price>—</span>{% endif %}
            {% if section.settings.show_source %}<a class="pq-compare__source" data-source target="_blank" rel="noopener noreferrer" aria-describedby="Source-tooltip-{{ side }}-{{ section.id }}" hidden><span class="pq-compare__source-label">{{ 'panquire.storefront.source' | t | escape_once }}</span><span class="pq-compare__source-icon" aria-hidden="true">ⓘ</span><span class="pq-compare__source-tooltip" id="Source-tooltip-{{ side }}-{{ section.id }}" role="tooltip" data-source-tooltip></span></a>{% endif %}
          </div>
          <p class="pq-compare__availability" data-availability></p>
        </div>
      {% endfor %}
    </div>
    <section class="pq-compare__showdown" aria-labelledby="Showdown-{{ section.id }}">
      <header class="pq-compare__heading">
        <h2 id="Showdown-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        <p>{{ section.settings.supporting_text | escape }}</p>
        <div class="pq-compare__legend"><span data-legend="panquire">T-01</span><span data-legend="competitor">E Ride Pro S (17&quot;)</span></div>
      </header>
      <div class="pq-compare__analysis {% unless section.settings.show_radar %}pq-compare__analysis--table-only{% endunless %}">
        {% if section.settings.show_radar %}
          <div class="pq-compare__chart">
            <svg data-radar viewBox="0 0 440 400" role="img" aria-label="Comparison radar. Exact values are available in the specification tables."></svg>
            <div class="pq-compare__metrics" aria-label="{{ 'panquire.storefront.explore_specifications' | t | escape_once }}" data-metrics></div>
            <p class="pq-compare__chart-note" data-chart-note></p>
          </div>
        {% endif %}
        <div class="pq-compare__differences">
          <div class="pq-compare__table-title"><h3 data-table-title>{{ 'panquire.storefront.biggest_differences' | t | escape_once }}</h3><button type="button" data-reset hidden>{{ 'panquire.storefront.reset' | t | escape_once }}</button></div>
          <div class="pq-compare__table-scroll" role="region" aria-labelledby="Showdown-{{ section.id }}" tabindex="0"><table data-differences></table></div>
          <p class="pq-compare__margin-note">{{ 'panquire.storefront.difference_panquire_competition_accent_highlights_follow_each' | t | escape_once }}</p>
          <details class="pq-compare__full" {% if section.settings.specs_expanded %}open{% endif %}>
            <summary>{{ 'panquire.storefront.view_all_specifications' | t | escape_once }} <span aria-hidden="true">↓</span></summary>
            <div class="pq-compare__table-scroll" role="region" aria-label="{{ 'panquire.storefront.complete_specifications' | t | escape_once }}" tabindex="0"><table data-full-specs></table></div>
          </details>
        </div>
      </div>
    </section>
    <p class="visually-hidden" role="status" aria-live="polite" data-status></p>
    <noscript><p>{{ 'panquire.storefront.the_panquire_model_selection_table_below_is' | t | escape_once }}</p></noscript>
    {% render 'pq-comparison-guide', section_id: section.id, regional_tables: regional_tables, comparison_currency: comparison_currency %}
  </div>
</pq-comparison>
{% stylesheet %}
  .pq-compare .pq-compare__pill[hidden], .pq-compare .pq-compare__source[hidden] {
    display: none;
  }
{% endstylesheet %}
{% schema %}
{
  "name": "VS Competition",
  "settings": [
    {"type":"text","id":"heading","label":"Section heading","default":"SPEC SHOWDOWN"},
    {"type":"text","id":"supporting_text","label":"Supporting text","default":"Select an area to explore the differences"},
    {"type":"product","id":"default_product","label":"Default Panquire product","info":"Choose T-01, T-02, or T-03."},
    {"type":"metaobject","id":"default_competitor","label":"Default competitor","metaobject_type":"competitor_product"},
    {"type":"textarea","id":"t01_competitors","label":"T-01 competitors (in order)","info":"Comma-separated handles of existing Competition Product entries. The first available entry is selected by default."},
    {"type":"textarea","id":"t02_competitors","label":"T-02 competitors (in order)","info":"Comma-separated handles of existing Competition Product entries. The first available entry is selected by default."},
    {"type":"textarea","id":"t03_competitors","label":"T-03 competitors (in order)","info":"Comma-separated handles of existing Competition Product entries. The first available entry is selected by default."},
    {"type":"range","id":"difference_count","label":"Legacy differences count","info":"The fixed showdown categories now show all mutually available values; this saved setting is retained for compatibility.","min":3,"max":10,"step":1,"default":6},
    {"type":"checkbox","id":"show_radar","label":"Show radar chart","default":true},
    {"type":"checkbox","id":"show_price","label":"Show price","default":true},
    {"type":"checkbox","id":"show_source","label":"Show Source","default":true},
    {"type":"checkbox","id":"specs_expanded","label":"Start full specifications expanded","default":false},
    {"type":"color","id":"competitor_color","label":"Competition crimson","default":"#D85B59"}
  ],
  "presets": [{"name":"VS Competition"}]
}
{% endschema %}
