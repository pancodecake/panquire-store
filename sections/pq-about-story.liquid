<div class="pq pq-about-editorial pq-section">
  <div class="pq-container">
    <section class="pq-brand-layout" aria-labelledby="Brand-{{ section.id }}">
      <div class="pq-brand-column pq-brand-column--left">
        <h1 class="pq-section-title" id="Brand-{{ section.id }}">{{ section.settings.brand_heading | escape }}</h1>
        {% assign brand_text_index = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'brand_text' %}
            {% assign brand_text_index = brand_text_index | plus: 1 %}
            {% if brand_text_index == 1 %}
              <div class="pq-prose pq-brand-intro" {{ block.shopify_attributes }}>{{ block.settings.content }}</div>
            {% endif %}
          {% endif %}
        {% endfor %}
        <div class="pq-brand-images">
          {% assign brand_keys = 'brand_primary,brand_secondary' | split: ',' %}
          {% assign brand_files = 'pq-about-hydraulic.jpg,pq-about-chamber.jpg' | split: ',' %}
          {% assign brand_alts = 'Hydraulic presses on the factory production floor|Process chamber and bicycle frames in the factory' | split: '|' %}
          {% for key in brand_keys %}
            {% if section.settings[key] != blank %}
              {{ section.settings[key] | image_url: width: 1400 | image_tag: widths: '400, 700, 1000, 1400', sizes: '(min-width: 750px) 440px, 85vw', loading: 'eager' }}
            {% else %}
              <img src="{{ brand_files[forloop.index0] | asset_url }}" width="1600" height="1073" alt="{{ brand_alts[forloop.index0] | escape }}"{% if forloop.first %} fetchpriority="high"{% endif %}>
            {% endif %}
          {% endfor %}
        </div>
        {% assign brand_text_index = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'brand_text' %}
            {% assign brand_text_index = brand_text_index | plus: 1 %}
            {% if brand_text_index == 5 %}
              <div class="pq-prose pq-brand-quote" {{ block.shopify_attributes }}>{{ block.settings.content }}</div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
      <div class="pq-brand-column pq-brand-column--right pq-prose" style="margin-top: 35%">
        {% assign brand_text_index = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'brand_text' %}
            {% assign brand_text_index = brand_text_index | plus: 1 %}
            {% case brand_text_index %}
              {% when 2 %}<div class="pq-brand-story" {{ block.shopify_attributes }}>{{ block.settings.content }}</div>
              {% when 3 %}<div class="pq-brand-engineering" {{ block.shopify_attributes }}>{{ block.settings.content }}</div>
              {% when 4 %}<div class="pq-brand-purpose" {{ block.shopify_attributes }}>{{ block.settings.content }}</div>
            {% endcase %}
          {% endif %}
        {% endfor %}
      </div>
    </section>
    <section class="pq-manufacturer" aria-labelledby="Manufacturer-{{ section.id }}">
      <h2 class="pq-section-title" id="Manufacturer-{{ section.id }}">{{ section.settings.manufacturer_heading | escape }}</h2>
      <div class="pq-prose">{{ section.settings.manufacturer }}</div>
      <div class="pq-certificates">
        {% for block in section.blocks %}
          {% if block.type == 'certificate' %}
            <details class="pq-certificate" {{ block.shopify_attributes }}>
              <summary><span>{{ block.settings.heading | escape }}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
              <div class="pq-certificate-body pq-prose">{{ block.settings.body }}</div>
            </details>
          {% endif %}
        {% endfor %}
      </div>
      <div class="pq-factory-images">
        {% assign image_keys = 'factory_primary,factory_top,factory_bottom' | split: ',' %}
        {% assign image_files = 'pq-about-fabrication.jpg,pq-about-blueprint.jpg,pq-about-machining.jpg' | split: ',' %}
        {% assign image_alts = 'Fabrication equipment and racks of bicycle frames|Bicycle frame laid over its engineering blueprint|Machined components and blue storage bins on the factory floor' | split: '|' %}
        {% for key in image_keys %}
          {% if section.settings[key] != blank %}
            {{ section.settings[key] | image_url: width: 1600 | image_tag: widths: '500, 800, 1200, 1600', sizes: '(min-width: 750px) 510px, 90vw', loading: 'lazy' }}
          {% else %}
            <img src="{{ image_files[forloop.index0] | asset_url }}" width="1600" height="1200" alt="{{ image_alts[forloop.index0] | escape }}" loading="lazy">
          {% endif %}
        {% endfor %}
      </div>
    </section>
  </div>
</div>
{% stylesheet %}
  .pq-brand-layout { display: grid; grid-template-columns: minmax(0,.92fr) minmax(0,1.08fr); gap: 54px; align-items: start; }
  .pq-brand-column { display: flex; flex-direction: column; gap: 28px; min-width: 0; }
  .pq-about-editorial .pq-prose { max-width: none; color: var(--color-text-secondary); font-size: 16px; line-height: 1.75; }
  .pq-about-editorial .pq-prose strong { color: var(--color-text-primary); }
  .pq-about-editorial .pq-prose > * + * { margin-top: 1em; }
  .pq-brand-layout .pq-section-title { margin: 0 !important; color: var(--color-heading-accent);}
  .pq-brand-layout .pq-prose p { max-width: 61ch; margin: 0; }
  .pq-brand-intro p { padding-left: 22px; border-left: 3px solid var(--color-accent-solid); color: var(--color-text-primary); font-family: var(--pq-heading-font); font-size: clamp(19px,2vw,24px); font-weight: 600; line-height: 1.5; letter-spacing: -.018em; }
  .pq-brand-story { padding-bottom: 28px; border-bottom: 1px solid var(--color-border); }
  .pq-brand-purpose { width: fit-content; color: var(--color-heading-accent); font-family: var(--pq-heading-font); font-size: 17px; font-weight: 650; line-height: 1.55; }
  .pq-brand-engineering { padding-left: 20px; border-left: 1px solid var(--color-border-strong); }
  .pq-brand-quote p { position: relative; padding: 22px 0 22px 44px; border-block: 1px solid var(--color-border-strong); color: var(--color-text-primary); font-family: var(--pq-heading-font); font-size: clamp(18px,1.9vw,23px); font-weight: 700; line-height: 1.45; letter-spacing: -.02em; }
  .pq-brand-quote p::before { content: '\201C'; position: absolute; top: 12px; left: 0; color: var(--color-accent-solid); font-family: var(--pq-heading-font); font-size: 54px; font-weight: 700; line-height: 1; }
  .pq-brand-images { position: relative; padding-right: 17%; }
  .pq-brand-images img, .pq-factory-images img { display: block; width: 100%; object-fit: cover; border-radius: 24px; }
  .pq-brand-images img:first-child { aspect-ratio: .95; height: auto; }
  .pq-brand-images img:last-child { position: absolute; right: 0; top: 20%; width: 43%; height: 60%; border: 6px solid var(--color-bg-page); }
  .pq-manufacturer { margin-top: 70px; padding-top: 56px;}
  .pq-manufacturer > .pq-section-title { margin-bottom: 20px !important; }
  .pq-manufacturer > .pq-prose > p:first-child { max-width: 68ch; color: var(--color-text-primary); font-size: clamp(18px,1.8vw,22px); line-height: 1.6; }
  .pq-manufacturer > .pq-prose > ul { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 0 40px; margin: 34px 0 0; padding: 0; list-style: none; }
  .pq-manufacturer > .pq-prose > ul li { min-width: 0; padding: 15px 0; border-top: 1px solid var(--color-border); }
  .pq-manufacturer > .pq-prose > ul strong { display: block; margin-bottom: 3px; color: var(--color-heading-accent); font-family: var(--pq-heading-font); font-size: 13px; font-weight: 650; line-height: 1.4; }
  .pq-manufacturer > .pq-prose a { color: var(--color-text-primary); text-decoration-color: var(--color-accent-solid); }
  .pq-certificates { display: grid; gap: 12px; margin-block: 32px; }
  .pq-certificate { border: 1px solid var(--color-border-strong); border-radius: 17px; background: linear-gradient(135deg,color-mix(in srgb,var(--color-bg-surface) 96%,white),var(--color-bg-surface)); box-shadow: inset 0 1px color-mix(in srgb,white 5%,transparent); overflow: clip; transition: border-color 220ms ease, box-shadow 220ms ease; }
  .pq .pq-certificate summary { position: relative; isolation: isolate; display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; padding: 16px 21px; list-style: none; cursor: pointer; font: 450 clamp(10px,2.35vw,25px)/1.18 var(--pq-heading-font); }
  .pq-certificate summary::-webkit-details-marker { display: none; }
  .pq-certificate summary::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--color-accent-solid); transform: scaleX(0); transform-origin: left; transition: transform 480ms var(--pq-ease-out); }
  .pq-certificate[open] summary::before { transform: scaleX(1); transform-origin: right; }
  .pq-certificate:hover { border-color: var(--color-accent-solid); box-shadow: 0 0 0 3px color-mix(in srgb,var(--color-accent-solid) 9%,transparent); }
  .pq-certificate summary:focus-visible { outline-offset: -4px; }
  .pq-certificate summary svg { flex: 0 0 30px; width: 30px; height: 30px; fill: none; stroke: var(--color-accent-solid); stroke-width: 2; transition: transform 480ms var(--pq-ease-out); }
  .pq-certificate[open] summary { color: var(--color-text-on-action); }
  .pq-certificate[open] summary svg { stroke: currentColor; transform: rotate(180deg); }
  .pq-certificate::details-content { interpolate-size: allow-keywords; block-size: 0; opacity: 0; overflow: clip; transition: block-size 480ms var(--pq-ease-out), opacity 190ms ease, content-visibility 480ms allow-discrete; }
  .pq-certificate[open]::details-content { block-size: auto; opacity: 1; }
  .pq-certificate-body { padding: 28px; }
  .pq-certificate-body > p:first-child { max-width: 72ch; color: var(--color-text-primary); font-size: 17px; }
  .pq-certificate-body > ul { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 0 32px; margin: 26px 0 0; padding: 0; list-style: none; }
  .pq-certificate-body > ul li { min-width: 0; padding: 13px 0; border-top: 1px solid var(--color-border); }
  .pq-certificate-body > ul strong { display: block; margin-bottom: 2px; color: var(--color-heading-accent); font-size: 13px; }
  .pq-factory-images { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 230px 230px; gap: 24px; }
  .pq-factory-images img { height: 100%; min-height: 0; }
  .pq-factory-images img:first-child { grid-row: span 2; }
  @media (max-width: 749px) {
    .pq-brand-layout { grid-template-columns: 1fr; gap: 32px; }
    .pq-brand-column { display: contents; }
    .pq-brand-layout .pq-section-title { grid-row: 1; }
    .pq-brand-intro { grid-row: 2; }
    .pq-brand-images { grid-row: 3; }
    .pq-brand-story { grid-row: 4; }
    .pq-brand-engineering { grid-row: 5; }
    .pq-brand-purpose { grid-row: 6; }
    .pq-brand-quote { grid-row: 7; }
    .pq-brand-images { max-width: 540px; padding-right: 12%; }
    .pq-brand-images img:first-child { aspect-ratio: 1.2; }
    .pq-brand-images img:last-child { width: 38%; }
    .pq-manufacturer { margin-top: 48px; padding-top: 40px; }
    .pq-brand-engineering { margin-left: 0; }
    .pq-brand-quote p { padding-left: 36px; }
    .pq-manufacturer > .pq-prose > ul, .pq-certificate-body > ul { grid-template-columns: 1fr; }
    .pq-factory-images { grid-template-rows: 280px 160px; gap: 16px; }
    .pq-factory-images img:first-child { grid-column: span 2; grid-row: auto; }
    .pq-certificate-body { padding: 20px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pq-certificate, .pq-certificate::details-content, .pq-certificate summary::before, .pq-certificate summary svg { transition: none; }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Panquire about story",
  "settings": [
    { "type": "text", "id": "brand_heading", "label": "Brand heading", "default": "Our Brand" },
    { "type": "paragraph", "content": "Drag the five Brand text blocks to move copy between the About-page layout positions." },
    { "type": "image_picker", "id": "brand_primary", "label": "Brand primary image" },
    { "type": "image_picker", "id": "brand_secondary", "label": "Brand overlapping image" },
    { "type": "text", "id": "manufacturer_heading", "label": "Manufacturer heading", "default": "Manufacturer Info" },
    { "type": "richtext", "id": "manufacturer", "label": "Manufacturer information" },
    { "type": "image_picker", "id": "factory_primary", "label": "Factory large image" },
    { "type": "image_picker", "id": "factory_top", "label": "Factory top right image" },
    { "type": "image_picker", "id": "factory_bottom", "label": "Factory bottom right image" }
  ],
  "blocks": [
    { "type": "brand_text", "name": "Brand text", "limit": 5, "settings": [
      { "type": "text", "id": "label", "label": "Editor label", "default": "Text block" },
      { "type": "richtext", "id": "content", "label": "Content" }
    ] },
    { "type": "certificate", "name": "Certificate", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Certificate" },
      { "type": "richtext", "id": "body", "label": "Details" }
    ] }
  ],
  "presets": [{ "name": "Panquire about story" }]
}
{% endschema %}
