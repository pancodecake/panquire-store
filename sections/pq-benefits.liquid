<section class="pq pq-benefits">
  <div class="pq-container pq-benefit-grid">
    {% for block in section.blocks %}
      {% case forloop.index %}
        {% when 1 %}{% assign benefit_icon = 'global-svgrepo-com.svg' %}
        {% when 2 %}{% assign benefit_icon = 'invoice-warranty-line-svgrepo-com.svg' %}
        {% when 3 %}{% assign benefit_icon = 'return-vector.svg' %}
        {% when 4 %}{% assign benefit_icon = 'factory-svgrepo-com.svg' %}
      {% endcase %}
      <div class="pq-benefit" {{ block.shopify_attributes }}><span class="pq-benefit-icon" aria-hidden="true">{{ benefit_icon | inline_asset_content }}</span><div><h2>{{ block.settings.heading | escape }}</h2><p>{{ block.settings.text | escape }}</p></div></div>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name": "Panquire service strip", "max_blocks": 4,
  "blocks": [{ "type": "benefit", "name": "Service item", "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Delivery" },
    { "type": "text", "id": "text", "label": "Description", "default": "Delivery details coming soon." }
  ] }],
  "presets": [{ "name": "Panquire service strip", "blocks": [{"type":"benefit"},{"type":"benefit"},{"type":"benefit"},{"type":"benefit"}] }]
}
{% endschema %}
