{% assign hero = section.blocks.first %}
<section
  class="pq pq-hero"
  aria-label="{{ section.settings.label | escape }}"
  style="--pq-hero-height: {{ section.settings.desktop_height }}px; --pq-hero-mobile-height: {{ section.settings.mobile_height }}px; --pq-hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --pq-hero-content-width: {{ section.settings.content_width }}px; --pq-hero-focus-x: {{ section.settings.image_position }}%;"
>
  {% if hero != blank %}
    <div class="pq-hero-slide" {{ hero.shopify_attributes }}>
      <div class="pq-hero-media">
        {% assign media_label = 'panquire.hero_image' | t %}
        {% render 'pq-media', image: hero.settings.image, label: media_label, eager: true, sizes: '100vw' %}
      </div>
      <div class="pq-hero-copy pq-container" style="--pq-hero-text: {{ hero.settings.text_color }};">
        <div class="pq-hero-content">
          {% if hero.settings.kicker != blank %}<p class="pq-hero-kicker">{{ hero.settings.kicker | escape }}</p>{% endif %}
          {% if hero.settings.heading != blank %}<h1>{{ hero.settings.heading | escape }}</h1>{% endif %}
          {% if hero.settings.text != blank %}<p class="pq-hero-description">{{ hero.settings.text | escape }}</p>{% endif %}
          <div class="pq-hero-actions">
            {% if hero.settings.link != blank and hero.settings.button != blank %}
              <a class="pq-button pq-button--primary" href="{{ hero.settings.link }}">{{ hero.settings.button | escape }} {% render 'pq-icon', name: 'arrow' %}</a>
            {% endif %}
            {% if hero.settings.secondary_link != blank and hero.settings.secondary_button != blank %}
              <a class="pq-button pq-button--secondary" href="{{ hero.settings.secondary_link }}">{{ hero.settings.secondary_button | escape }} {% render 'pq-icon', name: 'arrow' %}</a>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  {% endif %}
</section>
{% schema %}
{
  "name": "Panquire hero",
  "max_blocks": 1,
  "settings": [
    { "type": "text", "id": "label", "label": "Accessible section name", "default": "Featured collection" },
    { "type": "range", "id": "desktop_height", "label": "Desktop height", "min": 520, "max": 900, "step": 20, "unit": "px", "default": 680 },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 480, "max": 760, "step": 20, "unit": "px", "default": 620 },
    { "type": "range", "id": "overlay_opacity", "label": "Image overlay", "min": 30, "max": 90, "step": 5, "unit": "%", "default": 70 },
    { "type": "range", "id": "image_position", "label": "Image horizontal position", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 360, "max": 680, "step": 20, "unit": "px", "default": 520 }
  ],
  "blocks": [{ "type": "slide", "name": "Hero content", "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "Introducing Panquire" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Go small. Ride big." },
    { "type": "text", "id": "text", "label": "Description", "default": "Find your next adventure with a ride designed for everyday freedom." },
    { "type": "text", "id": "button", "label": "Primary button label", "default": "Explore products" },
    { "type": "url", "id": "link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_button", "label": "Secondary button label", "default": "Our story" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#F3F3F1" }
  ] }],
  "presets": [{ "name": "Panquire hero", "blocks": [{ "type": "slide" }] }]
}
{% endschema %}
