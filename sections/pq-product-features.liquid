<section class="pq pq-section pq-product-features" style="--pq-space: {{ section.settings.spacing }}px;">
  <div class="pq-container">
    <h2 class="pq-section-title" data-pq-reveal>{{ section.settings.heading | escape }}</h2>
    <div class="pq-feature-mosaic">
      {% for block in section.blocks %}
        <article class="pq-feature-tile" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <div class="pq-feature-tile-media">
              {{ block.settings.image | image_url: width: 1600 | image_tag: widths: '480, 750, 1100, 1600', sizes: '(min-width: 750px) 520px, 100vw', loading: 'lazy', alt: block.settings.image_alt, class: 'pq-image' }}
            </div>
          {% endif %}
          <div class="pq-feature-tile-copy">
            <span class="pq-feature-tile-label">{{ block.settings.label | escape }}</span>
            <h3>{{ block.settings.heading | escape }}</h3>
            <p>{{ block.settings.text | escape }}</p>
            {% if block.settings.detail != blank %}<strong class="pq-feature-tile-detail">{{ block.settings.detail | escape }}</strong>{% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
{% stylesheet %}
  .pq-product-features .pq-feature-mosaic { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .pq-product-features .pq-feature-tile { overflow: hidden; background: var(--pq-surface); border: 1px solid var(--pq-line); }
  .pq-product-features .pq-feature-tile-media { aspect-ratio: 1.65; background: var(--pq-bg); }
  .pq-product-features .pq-feature-tile-media img { object-fit: contain; }
  .pq-product-features .pq-feature-tile-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; padding: 26px; border-top: 0; }
  .pq-product-features .pq-feature-tile-label { color: var(--pq-accent); font-size: 12px; font-weight: 700; letter-spacing: .08em; }
  .pq-product-features .pq-feature-tile h3 { margin: 0; color: var(--color-heading-accent); font-size: clamp(23px, 2.2vw, 32px); line-height: 1.15; }
  .pq-product-features .pq-feature-tile p { margin: 0; color: var(--pq-muted); font-size: 15px; line-height: 1.65; }
  .pq-product-features .pq-feature-tile-detail { margin-top: auto; padding-top: 8px; color: var(--pq-text); font-size: 13px; }
  @media (max-width: 749px) { .pq-product-features .pq-feature-mosaic { grid-template-columns: minmax(0, 1fr); } }
{% endstylesheet %}
{% schema %}
{
  "name": "Panquire bike details",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Panquire electric motorcycles" },
    { "type": "range", "id": "spacing", "label": "Section spacing", "min": 20, "max": 160, "step": 10, "unit": "px", "default": 70 }
  ],
  "blocks": [{ "type": "feature", "name": "Feature", "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "text", "id": "label", "label": "Feature label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Description" },
    { "type": "text", "id": "detail", "label": "Feature detail" }
  ] }],
  "presets": [{ "name": "Panquire bike details" }]
}
{% endschema %}
