<section class="pq pq-section pq-product-features" style="--pq-space: {{ section.settings.spacing }}px;">
  <div class="pq-container">
    <h2 class="pq-product-heading" data-pq-reveal>{{ section.settings.heading | escape }}</h2>
    {% if section.settings.text != blank %}<p class="pq-product-intro" data-pq-reveal style="--pq-reveal-delay: 50ms;">{{ section.settings.text | escape }}</p>{% endif %}
    <div class="pq-feature-mosaic" data-pq-reveal style="--pq-reveal-delay: 100ms;">
      {% for block in section.blocks %}
        <article class="pq-feature-tile" {{ block.shopify_attributes }}>
          <div class="pq-feature-tile-media">{% render 'pq-media', image: block.settings.image, label: block.settings.media_label, sizes: '(min-width: 750px) 520px, 100vw' %}</div>
          <div class="pq-feature-tile-copy"><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.text | escape }}</p></div>
          {% if block.settings.link != blank %}<a class="pq-feature-tile-link" href="{{ block.settings.link }}"><span>{{ block.settings.link_label | escape }}</span></a>{% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Panquire feature mosaic","max_blocks":8,
  "settings":[
    {"type":"text","id":"heading","label":"Heading","default":"Explore every detail"},
    {"type":"textarea","id":"text","label":"Introduction"},
    {"type":"range","id":"spacing","label":"Section spacing","min":20,"max":160,"step":10,"unit":"px","default":70}
  ],
  "blocks":[{"type":"feature","name":"Feature","settings":[
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"text","id":"media_label","label":"Placeholder label","default":"Feature image placeholder"},
    {"type":"text","id":"heading","label":"Heading","default":"Feature heading"},
    {"type":"textarea","id":"text","label":"Description","default":"Product details coming soon."},
    {"type":"url","id":"link","label":"Optional review or feature link"},
    {"type":"text","id":"link_label","label":"Link label","default":"Explore this feature"}
  ]}],
  "presets":[{"name":"Panquire feature mosaic","blocks":[{"type":"feature"},{"type":"feature"},{"type":"feature"},{"type":"feature"}]}]
}
{% endschema %}
