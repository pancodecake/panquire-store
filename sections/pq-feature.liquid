<section class="pq pq-section pq-feature" style="--pq-space: {{ section.settings.spacing }}px;" data-pq-feature>
  {% if section.settings.show_campaign %}<div class="pq-campaign" style="--pq-campaign-height: {{ section.settings.campaign_height }}px;">{% assign media_label = 'panquire.campaign_media' | t %}{% render 'pq-media', image: section.settings.campaign_image, label: media_label, sizes: '100vw' %}</div>{% endif %}
  <div class="pq-container">
    <h2 class="pq-section-title" data-pq-reveal><span>{{ section.settings.heading | escape }}</span>{% if section.settings.subtitle != blank %}<small>{{ section.settings.subtitle | escape }}</small>{% endif %}</h2>
    <div class="pq-feature-layout" data-pq-reveal style="--pq-reveal-delay: 50ms;">
      <div class="pq-feature-panels">
        {% for block in section.blocks %}
          <article class="pq-feature-panel" id="Feature-{{ section.id }}-{{ block.id }}" data-pq-panel {{ block.shopify_attributes }}>
            <div class="pq-feature-image">
              {% if block.settings.image != blank %}
                {% assign media_label = 'panquire.product_image' | t %}
                {% render 'pq-media', image: block.settings.image, label: media_label, sizes: '(min-width: 900px) 760px, 100vw' %}
              {% else %}
                {% if block.settings.model == 'T-02' %}
                  <img class="pq-image" src="{{ 'panquire-t02.png' | asset_url }}" alt="Panquire T-02 electric dirt bike" width="2880" height="2880" loading="lazy">
                {% else %}
                  <img class="pq-image" src="{{ 'panquire-t01.png' | asset_url }}" alt="Panquire T-01 electric dirt bike" width="3200" height="2560" loading="lazy">
                {% endif %}
              {% endif %}
            </div>
            <div class="pq-feature-copy">
              <span class="pq-feature-kicker">Featured ride</span>
              <h3>{{ block.settings.heading | escape }}</h3>
              {% if block.settings.text != blank %}<p>{{ block.settings.text | escape }}</p>{% endif %}
              <dl class="pq-specs">{% for n in (1..4) %}{% assign label_key = 'label_' | append: n %}{% assign value_key = 'value_' | append: n %}{% if block.settings[label_key] != blank %}<div><dt>{{ block.settings[label_key] | escape }}</dt><dd>{{ block.settings[value_key] | escape }}</dd></div>{% endif %}{% endfor %}</dl>
              {% if block.settings.product != blank %}<a class="pq-text-link" href="{{ block.settings.product.url }}">{{ 'panquire.view_product' | t }} {% render 'pq-icon', name: 'arrow' %}</a>{% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
      <div class="pq-feature-selectors" data-pq-selectors hidden aria-label="Choose a bike model">{% for block in section.blocks %}<button type="button" data-pq-select="{{ forloop.index0 }}" aria-controls="Feature-{{ section.id }}-{{ block.id }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{{ block.settings.model | escape }}</button>{% endfor %}</div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Panquire product feature", "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Adventure" },
    { "type": "text", "id": "subtitle", "label": "Subheading", "default": "Find your next ride" },
    { "type": "checkbox", "id": "show_campaign", "label": "Show large campaign media above", "default": true },
    { "type": "image_picker", "id": "campaign_image", "label": "Campaign image" },
    { "type": "range", "id": "campaign_height", "label": "Desktop campaign height", "min": 300, "max": 1200, "step": 50, "unit": "px", "default": 1000 },
    { "type": "range", "id": "spacing", "label": "Bottom spacing", "min": 20, "max": 160, "step": 10, "unit": "px", "default": 80 }
  ],
  "blocks": [{ "type": "model", "name": "Featured model", "settings": [
    { "type": "text", "id": "model", "label": "Model selector label", "default": "Model 01" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everyday adventures" },
    { "type": "textarea", "id": "text", "label": "Description", "default": "Meet the upcoming Panquire collection. Product details will be shared here." },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "image", "label": "Custom product image" },
    { "type": "text", "id": "label_1", "label": "First specification label", "default": "Performance" },
    { "type": "text", "id": "value_1", "label": "First specification value", "default": "Coming soon" },
    { "type": "text", "id": "label_2", "label": "Second specification label", "default": "Power" },
    { "type": "text", "id": "value_2", "label": "Second specification value", "default": "Coming soon" },
    { "type": "text", "id": "label_3", "label": "Third specification label", "default": "Range" },
    { "type": "text", "id": "value_3", "label": "Third specification value", "default": "Coming soon" },
    { "type": "text", "id": "label_4", "label": "Fourth specification label" },
    { "type": "text", "id": "value_4", "label": "Fourth specification value" }
  ] }],
  "presets": [{ "name": "Panquire product feature", "blocks": [{"type":"model"},{"type":"model"},{"type":"model"}] }]
}
{% endschema %}
