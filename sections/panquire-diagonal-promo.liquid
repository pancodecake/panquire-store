{% liquid
  assign left_alt = section.settings.left_image.alt | default: 'Panquire electric motorcycle on a forest trail'
  assign right_alt = section.settings.right_image.alt | default: 'Panquire electric motorcycle in a rocky stream'
%}

<section
  class="pq pq-diagonal-promo"
  aria-labelledby="DiagonalPromo-{{ section.id }}"
  style="--promo-height: {{ section.settings.desktop_height }}px; --promo-space: {{ section.settings.spacing }}px; --promo-banner: {{ section.settings.banner_color }}; --promo-text: {{ section.settings.text_color }}; --promo-highlight: {{ section.settings.highlight_color }}; --promo-accent: {{ section.settings.accent_color }}; --promo-left-x: {{ section.settings.left_x }}%; --promo-left-y: {{ section.settings.left_y }}%; --promo-right-x: {{ section.settings.right_x }}%; --promo-right-y: {{ section.settings.right_y }}%;"
>
  <div class="pq-diagonal-promo__frame">
    <div class="pq-diagonal-promo__media pq-diagonal-promo__media--left">
      {% if section.settings.left_image != blank %}
        {{ section.settings.left_image | image_url: width: 2400 | image_tag: widths: '600, 900, 1200, 1600, 2000, 2400', sizes: '(min-width: 1200px) 62vw, (min-width: 768px) 68vw, 100vw', loading: 'lazy', alt: left_alt }}
      {% else %}
        <img src="{{ 'panquire-diagonal-left.jpg' | asset_url }}" alt="{{ left_alt | escape }}" width="1800" height="2400" loading="lazy" decoding="async">
      {% endif %}
    </div>

    <div class="pq-diagonal-promo__media pq-diagonal-promo__media--right">
      {% if section.settings.right_image != blank %}
        {{ section.settings.right_image | image_url: width: 2400 | image_tag: widths: '600, 900, 1200, 1600, 2000, 2400', sizes: '(min-width: 1200px) 62vw, (min-width: 768px) 68vw, 100vw', loading: 'lazy', alt: right_alt }}
      {% else %}
        <img src="{{ 'panquire-diagonal-right.jpg' | asset_url }}" alt="{{ right_alt | escape }}" width="1800" height="2400" loading="lazy" decoding="async">
      {% endif %}
    </div>

    <div class="pq-diagonal-promo__banner">
      <h2 id="DiagonalPromo-{{ section.id }}">
        <span>{{ section.settings.heading_accent | escape }}</span>
        <span>{{ section.settings.heading_line_2 | escape }}</span>
        <span>{{ section.settings.heading_line_3 | escape }}</span>
      </h2>
    </div>

    <i class="pq-diagonal-promo__accent pq-diagonal-promo__accent--top" aria-hidden="true"></i>
    <i class="pq-diagonal-promo__accent pq-diagonal-promo__accent--bottom" aria-hidden="true"></i>
  </div>
</section>

{% stylesheet %}
  .pq-diagonal-promo {
    padding-block: var(--promo-space);
    overflow: hidden;
  }

  .pq-diagonal-promo__frame {
    position: relative;
    isolation: isolate;
    container-type: inline-size;
    width: min(1600px, calc(100% - clamp(40px, 6vw, 120px)), calc(var(--promo-height) * 801 / 460));
    height: auto;
    aspect-ratio: 801 / 460;
    margin-inline: auto;
    overflow: hidden;
    background: var(--promo-banner);
  }

  .pq-diagonal-promo__media,
  .pq-diagonal-promo__banner {
    position: absolute;
    inset: 0;
  }

  .pq-diagonal-promo__media--left {
    clip-path: polygon(0 0, 60% 0, 0 100%);
  }

  .pq-diagonal-promo__media--right {
    clip-path: polygon(100% 0, 100% 100%, 40% 100%);
  }

  .pq-diagonal-promo__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pq-diagonal-promo__media--left img {
    width: 55%;
    object-position: var(--promo-left-x) var(--promo-left-y);
  }

  .pq-diagonal-promo__media--right img {
    width: 58%;
    margin-left: auto;
    object-position: var(--promo-right-x) var(--promo-right-y);
  }

  .pq-diagonal-promo__banner {
    z-index: 1;
    display: grid;
    place-items: center;
    clip-path: polygon(55% 0, 100% 0, 42% 100%, 0 100%);
    background: var(--promo-banner);
  }

  .pq-diagonal-promo__banner h2 {
    width: 42%;
    margin: 0;
    color: var(--promo-text);
    font-family: var(--pq-heading-font);
    font-size: 3.5cqw;
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -.045em;
    text-align: center;
    text-transform: uppercase;
  }

  .pq-diagonal-promo__banner h2 span {
    display: block;
  }

  .pq-diagonal-promo__banner h2 span:first-child {
    color: var(--promo-highlight);
  }

  .pq-diagonal-promo__accent {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: block;
    background: var(--promo-accent);
    pointer-events: none;
  }

  .pq-diagonal-promo__accent--top {
    /* Fill the full wedge between the frame edge and the banner. */
    clip-path: polygon(55% 0, 100% 0, 96.52% 6%, 51.7% 6%);
  }

  .pq-diagonal-promo__accent--bottom {
    clip-path: polygon(3.3% 94%, 45.48% 94%, 42% 100%, 0 100%);
  }

  @media (max-width: 767px) {
    .pq-diagonal-promo {
      padding-block: min(var(--promo-space), 56px);
    }

    .pq-diagonal-promo__frame {
      width: calc(100% - 32px);
      height: auto;
    }

  }
{% endstylesheet %}

{% schema %}
{
  "name": "Panquire diagonal promo",
  "settings": [
    { "type": "image_picker", "id": "left_image", "label": "Upper-left photograph" },
    { "type": "image_picker", "id": "right_image", "label": "Lower-right photograph" },
    { "type": "text", "id": "heading_accent", "label": "Accent headline line", "default": "Ride with us," },
    { "type": "text", "id": "heading_line_2", "label": "Headline line 2", "default": "is the ride with" },
    { "type": "text", "id": "heading_line_3", "label": "Headline line 3", "default": "nature." },
    { "type": "color", "id": "highlight_color", "label": "Headline accent color", "default": "#A97832" },
    { "type": "color", "id": "text_color", "label": "Main text color", "default": "#F3F3F1" },
    { "type": "color", "id": "banner_color", "label": "Central banner", "default": "#151619" },
    { "type": "color", "id": "accent_color", "label": "Geometric accents", "default": "#A97832" },
    { "type": "range", "id": "left_x", "label": "Left image horizontal position", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 55 },
    { "type": "range", "id": "left_y", "label": "Left image vertical position", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "right_x", "label": "Right image horizontal position", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 55 },
    { "type": "range", "id": "right_y", "label": "Right image vertical position", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 45 },
    { "type": "range", "id": "desktop_height", "label": "Maximum desktop frame height", "min": 480, "max": 900, "step": 20, "unit": "px", "default": 760 },
    { "type": "range", "id": "spacing", "label": "Vertical spacing", "min": 0, "max": 120, "step": 10, "unit": "px", "default": 70 }
  ],
  "presets": [{ "name": "Panquire diagonal promo" }]
}
{% endschema %}
