<article class="pq pq-partners">
  <header class="pq-container pq-page-intro" data-pq-reveal><p>{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}</h1><div class="pq-prose">{{ section.settings.intro }}</div></header>
  <div class="pq-container pq-partner-layout">
    <nav class="pq-partner-nav" aria-label="{{ section.settings.navigation_label | escape }}">
      {% for block in section.blocks %}<a href="#{{ block.settings.anchor | default: block.id | handleize }}">{{ block.settings.heading | escape }}</a>{% endfor %}
    </nav>
    <div class="pq-partner-sections">
      {% for block in section.blocks %}
        <section class="pq-partner-section" id="{{ block.settings.anchor | default: block.id | handleize }}" aria-labelledby="PartnerHeading-{{ block.id }}" data-pq-reveal {{ block.shopify_attributes }}>
          {% if block.settings.anchor == 'affiliate-terms' %}<span id="affiliate-program" class="pq-anchor" aria-hidden="true"></span>{% endif %}
          <h2 id="PartnerHeading-{{ block.id }}">{{ block.settings.heading | escape }}</h2>
          <div class="pq-prose">{{ block.settings.body }}</div>
          {% if block.settings.link != blank and block.settings.button != blank %}<a class="pq-button pq-button--accent" href="{{ block.settings.link }}">{{ block.settings.button | escape }}</a>{% endif %}
        </section>
      {% endfor %}
    </div>
  </div>
</article>
{% schema %}
{
  "name":"Panquire partner page","max_blocks":12,
  "settings":[
    {"type":"text","id":"eyebrow","label":"Small heading","default":"Business & partners"},
    {"type":"text","id":"heading","label":"Page heading","default":"Partner With Us"},
    {"type":"richtext","id":"intro","label":"Introduction","default":"<p>Explore partnerships, our affiliate program, and corporate purchasing.</p>"},
    {"type":"text","id":"navigation_label","label":"Navigation label","default":"On this page"}
  ],
  "blocks":[{"type":"chapter","name":"Partner section","settings":[
    {"type":"text","id":"heading","label":"Heading","default":"Partners"},
    {"type":"text","id":"anchor","label":"Link anchor","info":"Use a unique short name, e.g. corporate-purchase. Keep existing anchors when editing to preserve footer links."},
    {"type":"richtext","id":"body","label":"Content","default":"<p>Some placeholder text</p>"},
    {"type":"text","id":"button","label":"Button label"},
    {"type":"url","id":"link","label":"Button link"}
  ]}],
  "presets":[{"name":"Panquire partner page","blocks":[{"type":"chapter"}]}]
}
{% endschema %}
