{%- liquid
  assign footer_phone = section.settings.phone_number | default: shop.phone
  assign footer_phone_href = footer_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.'
  assign newsletter_form_id = 'FooterNewsletter-' | append: section.id
-%}

<footer class="pq pq-footer">
  <div class="pq-footer-newsletter">
    <div class="pq-container pq-footer-newsletter__layout">
      <div class="pq-footer-newsletter__copy">
        <p class="pq-footer-newsletter__eyebrow">{{ section.settings.newsletter_eyebrow | escape }}</p>
        <h2 id="FooterNewsletterHeading-{{ section.id }}">{{ section.settings.newsletter_heading | escape }}</h2>
      </div>

      {% form 'customer', id: newsletter_form_id, class: 'pq-footer-newsletter__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="FooterNewsletterEmail-{{ section.id }}">{{ section.settings.email_label | escape }}</label>
        <div class="pq-footer-newsletter__fields">
          <input
            id="FooterNewsletterEmail-{{ section.id }}"
            type="email"
            name="contact[email]"
            value="{{ form.email | escape }}"
            autocomplete="email"
            autocapitalize="off"
            autocorrect="off"
            placeholder="{{ section.settings.email_placeholder | escape }}"
            aria-labelledby="FooterNewsletterHeading-{{ section.id }}"
            {% if form.errors %}aria-invalid="true" aria-describedby="FooterNewsletterError-{{ section.id }}"{% endif %}
            required
          >
          <button type="submit">{{ section.settings.subscribe_label | escape }}</button>
        </div>
        {% if form.errors %}
          <div id="FooterNewsletterError-{{ section.id }}" class="pq-footer-newsletter__message pq-footer-newsletter__message--error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}
        {% if form.posted_successfully? %}
          <p class="pq-footer-newsletter__message" role="status">{{ section.settings.success_message | escape }}</p>
        {% endif %}
      {% endform %}
    </div>
  </div>

  <div class="pq-container">
    <div class="pq-footer-intro">
      <a href="{{ routes.root_url }}" class="pq-wordmark pq-footer-brand">{{ settings.pq_store_name | default: 'Panquire' | escape }}</a>

      <div class="pq-footer-trust" aria-labelledby="FooterTrustHeading-{{ section.id }}">
        <ul class="pq-footer-trust__grid" role="list">
          <li class="pq-trust-badge pq-trust-badge--guarantee">
            {% render 'pq-trust-icon', name: 'guarantee' %}
            <span><strong>{{ section.settings.guarantee_title | escape }}</strong><small>{{ section.settings.guarantee_text | escape }}</small></span>
          </li>
          <li class="pq-trust-badge">
            {% render 'pq-trust-icon', name: 'lock' %}
            <span><strong>{{ section.settings.ssl_title | escape }}</strong><small>{{ section.settings.ssl_text | escape }}</small></span>
          </li>
          <li class="pq-trust-badge">
            {% render 'pq-trust-icon', name: 'shield' %}
            <span><strong>{{ section.settings.safe_title | escape }}</strong><small>{{ section.settings.safe_text | escape }}</small></span>
          </li>
          <li class="pq-trust-badge pq-trust-badge--shopify">
            {% render 'pq-trust-icon', name: 'shopify' %}
            <span><strong>{{ section.settings.shopify_title | escape }}</strong><small>{{ section.settings.shopify_text | escape }}</small></span>
          </li>
        </ul>
        <h2 id="FooterTrustHeading-{{ section.id }}">{{ section.settings.trust_badges_caption | escape }}</h2>
      </div>
    </div>

    <div class="pq-footer-columns">
      {% for block in section.blocks %}{% if block.type == 'column' %}
        <div class="pq-footer-column" {{ block.shopify_attributes }}><h2>{{ block.settings.heading | escape }}</h2>
          {% if block.settings.menu != blank %}<nav aria-label="{{ block.settings.heading | escape }}">{% for link in block.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}</nav>
          {% elsif block.settings.built_in != blank and block.settings.built_in != 'none' %}
            {% render 'pq-footer-links', block: block, footer_settings: section.settings %}
          {% elsif block.settings.show_shop %}<a href="{{ routes.all_products_collection_url }}">{{ 'panquire.products' | t }}</a>
          {% endif %}
          {% if block.settings.show_policies %}{% for policy in shop.policies %}{% if policy != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}{% endif %}
          {% if block.settings.text != blank %}<div class="rte">{{ block.settings.text }}</div>{% endif %}
        </div>
      {% endif %}{% endfor %}

      <aside class="pq-footer-community" aria-label="{{ section.settings.community_label | escape }}">
        <div class="pq-footer-social" aria-labelledby="FooterSocialHeading-{{ section.id }}">
          <h2 id="FooterSocialHeading-{{ section.id }}">{{ section.settings.social_heading | escape }}</h2>
          <div class="pq-social-links">
            {% if section.settings.facebook_url != blank %}
              <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook — opens in a new tab">{% render 'pq-social-icon', name: 'facebook' %}</a>
            {% endif %}
            {% if section.settings.instagram_url != blank %}
              <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram — opens in a new tab">{% render 'pq-social-icon', name: 'instagram' %}</a>
            {% endif %}
            {% if section.settings.youtube_url != blank %}
              <a href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube — opens in a new tab">{% render 'pq-social-icon', name: 'youtube' %}</a>
            {% endif %}
            {% if section.settings.tiktok_url != blank %}
              <a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener noreferrer" aria-label="TikTok — opens in a new tab">{% render 'pq-social-icon', name: 'tiktok' %}</a>
            {% else %}
              <span class="pq-social-link--inactive" aria-label="TikTok — link coming soon">{% render 'pq-social-icon', name: 'tiktok' %}</span>
            {% endif %}
          </div>
        </div>

        <div class="pq-footer-contact" aria-labelledby="FooterContactHeading-{{ section.id }}">
          <h2 id="FooterContactHeading-{{ section.id }}">{{ section.settings.contact_heading | escape }}</h2>
          {% if footer_phone != blank %}
            <a href="tel:{{ footer_phone_href }}"><span>{{ section.settings.phone_label | escape }}</span><strong>{{ footer_phone | escape }}</strong></a>
          {% endif %}
          {% if section.settings.support_email != blank %}
            <a href="mailto:{{ section.settings.support_email | escape }}"><span>{{ section.settings.support_label | escape }}</span><strong>{{ section.settings.support_email | escape }}</strong></a>
          {% endif %}
        </div>
      </aside>
    </div>
    {% if section.settings.text != blank %}<p class="pq-footer-note">{{ section.settings.text | escape }}</p>{% endif %}
    <div class="pq-footer-bottom">
      <nav class="pq-footer-legal" aria-label="{{ section.settings.legal_label | escape }}"><a href="{{ settings.pq_terms_url | default: '/pages/terms' }}">{{ section.settings.terms_label | escape }}</a><a href="{{ section.settings.privacy_url | default: '/policies/privacy-policy' }}">{{ section.settings.privacy_label | escape }}</a></nav>
      <span>© {{ 'now' | date: '%Y' }} {{ settings.pq_store_name | default: 'Panquire' | escape }}. {{ section.settings.rights_text | escape }}</span>
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "Panquire footer", "enabled_on": { "groups": ["footer"] }, "max_blocks": 12,
  "settings": [
    {"type":"header","content":"Newsletter"},
    {"type":"text","id":"newsletter_eyebrow","label":"Eyebrow","default":"Ride farther. Know more."},
    {"type":"text","id":"newsletter_heading","label":"Heading","default":"Join the Panquire riding family"},
    {"type":"text","id":"email_label","label":"Email field label","default":"Email address"},
    {"type":"text","id":"email_placeholder","label":"Email placeholder","default":"Enter your email"},
    {"type":"text","id":"subscribe_label","label":"Button label","default":"Subscribe"},
    {"type":"text","id":"success_message","label":"Success message","default":"Thanks for joining the Panquire riding family."},
    {"type":"header","content":"Social media"},
    {"type":"text","id":"community_label","label":"Community area label","default":"Community and support"},
    {"type":"text","id":"social_heading","label":"Heading","default":"Follow Panquire"},
    {"type":"url","id":"facebook_url","label":"Facebook URL"},
    {"type":"url","id":"instagram_url","label":"Instagram URL"},
    {"type":"url","id":"youtube_url","label":"YouTube URL"},
    {"type":"url","id":"tiktok_url","label":"TikTok URL"},
    {"type":"header","content":"Phone and support"},
    {"type":"text","id":"contact_heading","label":"Heading","default":"Phone & support"},
    {"type":"text","id":"phone_label","label":"Phone label","default":"Phone"},
    {"type":"text","id":"phone_number","label":"Phone number","info":"Uses the Shopify store phone when left blank."},
    {"type":"text","id":"support_label","label":"Support label","default":"Support"},
    {"type":"text","id":"support_email","label":"Support email","default":"support@panquire.com"},
    {"type":"header","content":"Checkout trust badges"},
    {"type":"text","id":"trust_badges_caption","label":"Caption","default":"Protected checkout"},
    {"type":"text","id":"guarantee_title","label":"Guarantee title","default":"100%"},
    {"type":"text","id":"guarantee_text","label":"Guarantee text","default":"Money-back guarantee"},
    {"type":"text","id":"ssl_title","label":"SSL title","default":"Fully secured"},
    {"type":"text","id":"ssl_text","label":"SSL text","default":"SSL checkout"},
    {"type":"text","id":"safe_title","label":"Safe checkout title","default":"Safe checkout"},
    {"type":"text","id":"safe_text","label":"Safe checkout text","default":"Guaranteed"},
    {"type":"text","id":"shopify_title","label":"Shopify title","default":"Shopify"},
    {"type":"text","id":"shopify_text","label":"Shopify text","default":"Secure"},
    {"type":"header","content":"Footer details"},
    {"type":"textarea","id":"text","label":"Footer note"},
    {"type":"url","id":"contact_url","label":"Contact page"},
    {"type":"url","id":"privacy_url","label":"Privacy policy"},
    {"type":"text","id":"legal_label","label":"Legal navigation label","default":"Legal information"},
    {"type":"text","id":"terms_label","label":"Terms link label","default":"Terms of Service"},
    {"type":"text","id":"privacy_label","label":"Privacy link label","default":"Privacy Policy"},
    {"type":"text","id":"rights_text","label":"Copyright text","default":"All rights reserved."}
  ],
  "blocks": [
    { "type":"column","name":"Footer column","settings":[
      {"type":"text","id":"heading","label":"Heading","default":"Company"},
      {"type":"link_list","id":"menu","label":"Navigation menu"},
      {"type":"select","id":"built_in","label":"Default links","options":[{"value":"none","label":"None"},{"value":"shop","label":"Shop"},{"value":"company","label":"Company"},{"value":"business","label":"Business & Partners"},{"value":"care","label":"Customer Care"}],"default":"none","info":"A selected navigation menu replaces these defaults."},
      {"type":"product","id":"product_1","label":"First product"},
      {"type":"text","id":"product_1_label","label":"First product placeholder","default":"[Product 1 Name]"},
      {"type":"product","id":"product_2","label":"Second product"},
      {"type":"text","id":"product_2_label","label":"Second product placeholder","default":"[Product 2 Name]"},
      {"type":"richtext","id":"text","label":"Text or contact details"},
      {"type":"checkbox","id":"show_shop","label":"Show all products link","default":false},
      {"type":"checkbox","id":"show_policies","label":"Show store policy links","default":false}
    ]}
  ],
  "presets": [{ "name": "Panquire footer" }]
}
{% endschema %}
