<section class="pq pq-section" style="--pq-space: {{ section.settings.spacing }}px;" data-pq-carousel>
  <div class="pq-container">
    <h2 class="pq-section-title" data-pq-reveal><span>{{ section.settings.heading | escape }}</span><small>{{ section.settings.subtitle | escape }}</small></h2>
    <div class="pq-product-track" data-pq-track data-pq-reveal style="--pq-columns: {{ section.settings.columns }}; --pq-reveal-delay: 50ms;">
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: 8 %}<div data-pq-item>{% render 'pq-product-card', product: product %}</div>{% else %}{% for block in section.blocks %}<div data-pq-item {{ block.shopify_attributes }}>{% render 'pq-product-card', product: block.settings.product, card: block.settings %}</div>{% endfor %}{% endfor %}
      {% else %}
        {% for block in section.blocks %}<div data-pq-item {{ block.shopify_attributes }}>{% render 'pq-product-card', product: block.settings.product, card: block.settings %}</div>{% endfor %}
      {% endif %}
    </div>
    <div class="pq-track-controls" data-pq-controls hidden><span class="pq-track-rule" aria-hidden="true"></span><button class="pq-square" type="button" data-pq-prev aria-label="{{ 'panquire.previous' | t }}">‹</button><button class="pq-square" type="button" data-pq-next aria-label="{{ 'panquire.next' | t }}">›</button></div>
  </div>
</section>
{% schema %}
{
  "name": "Panquire product cards", "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Discover" },
    { "type": "text", "id": "subtitle", "label": "Subheading", "default": "The Panquire collection" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Overrides individual cards when this collection has products." },
    { "type": "range", "id": "columns", "label": "Desktop columns", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "spacing", "label": "Section spacing", "min": 20, "max": 160, "step": 10, "unit": "px", "default": 60 }
  ],
  "blocks": [{ "type": "product", "name": "Product card", "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "image", "label": "Custom image" },
    { "type": "text", "id": "title", "label": "Placeholder title", "default": "Panquire model" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "A new way to ride" },
    { "type": "text", "id": "details", "label": "Specification summary", "default": "Specifications coming soon" }
  ] }],
  "presets": [{ "name": "Panquire product cards", "blocks": [{"type":"product"},{"type":"product"},{"type":"product"}] }]
}
{% endschema %}
