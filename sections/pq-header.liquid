{% render 'pq-organization' %}
{% style %}
  #shopify-section-{{ section.id }} { position: sticky; top: 0; z-index: 30; }
{% endstyle %}
<header class="pq pq-header">
  {% if section.settings.announcement != blank %}<div class="pq-announcement">{{ section.settings.announcement | escape }}</div>{% endif %}
  <div class="pq-header-row pq-container">
    <a class="pq-wordmark" href="{{ routes.root_url }}"><img class="pq-brand-emblem" src="{{ 'panquire-logo-transparent.svg' | asset_url }}" width="36" height="36" alt="{{ settings.pq_store_name | default: 'Panquire' | escape }}"></a>
    <nav class="pq-desktop-nav" aria-label="{{ 'panquire.main_navigation' | t }}">{% render 'pq-navigation', menu: section.settings.menu %}</nav>
    <div class="pq-header-actions">
      <a class="pq-icon-button" href="{{ routes.search_url }}" aria-label="{{ 'panquire.search' | t }}">{% render 'pq-icon', name: 'search' %}</a>
      <a class="pq-icon-button" href="{{ routes.cart_url }}" aria-label="{{ 'panquire.cart' | t }}"><cart-icon>{% render 'pq-icon', name: 'cart' %}<span ref="cartBubble" class="pq-cart-count{% if cart.item_count == 0 %} visually-hidden{% endif %}"><span ref="cartBubbleText"><span ref="cartBubbleCount">{{ cart.item_count }}</span></span></span></cart-icon></a>
    </div>
    <details class="pq-mobile-menu">
      <summary aria-label="{{ 'panquire.menu' | t }}"><span class="pq-mobile-menu-icon" aria-hidden="true"><span></span><span></span><span></span></span></summary>
      <nav aria-label="{{ 'panquire.main_navigation' | t }}">{% render 'pq-navigation', menu: section.settings.menu %}</nav>
    </details>
  </div>
</header>
<script src="{{ 'cart-icon.js' | asset_url }}" type="module" fetchpriority="low"></script>
{% schema %}
{
  "name": "Panquire header",
  "enabled_on": { "groups": ["header"] },
  "settings": [{ "type": "text", "id": "announcement", "label": "Announcement", "default": "Welcome to Panquire" }, {"type":"link_list","id":"menu","label":"Main navigation menu"}],
  "presets": [{ "name": "Panquire header" }]
}
{% endschema %}
